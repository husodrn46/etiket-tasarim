<Project Sdk="Microsoft.NET.Sdk">
  <!--
    macOS masaüstü uygulamasının arayüz testleri. Avalonia'nın penceresiz (headless) platformunda gerçek pencere,
    gerçek tuval ve gerçek Skia çizimiyle çalışır: ekran, fare ya da işletim sistemi izni gerekmez.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AkelEtiket.App.Mac\AkelEtiket.App.Mac.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
