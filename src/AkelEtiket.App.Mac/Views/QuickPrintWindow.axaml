<views:DialogWindow xmlns:loc="using:AkelEtiket.App.Mac.Localization" x:CompileBindings="False" x:Class="AkelEtiket.App.Mac.Views.QuickPrintWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:AkelEtiket.App.Mac.Views"
                    xmlns:controls="using:AkelEtiket.App.Mac.Controls"
                    Title="{loc:Text T_930a0da1ee3b}" Width="1180" Height="720" MinWidth="900" MinHeight="520" CanResize="True">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,10">
            <TextBlock Text="{loc:Text T_930a0da1ee3b}" Classes="title" FontSize="18" />
            <TextBlock Classes="hint" Margin="0,4,0,0"
                       Text="{loc:Text T_f269e9504224}" />
        </StackPanel>

        <!-- Şablonlar -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Text T_a2a1a42069bd}" Classes="section" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border DockPanel.Dock="Left" Width="54" Height="54" Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,8,0">
                                <Image Source="{Binding PreviewPng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SizeText}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Ürün arama -->
        <DockPanel Grid.Row="1" Grid.Column="2" DataContext="{Binding}">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Text T_c5ddbc334a81}" Classes="section" Margin="0,0,0,6" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{loc:Text T_b8bedfa2f9b8}" Margin="8,0,0,0" Click="OnManageProducts" />
                <TextBox x:Name="ScanBox" Text="{Binding ScanInput}" FontSize="15"
                         ToolTip.Tip="{loc:Text T_40baf449a813}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </DockPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding Products.Query, Delay=200}" Margin="0,0,0,6"
                     ToolTip.Tip="{loc:Text T_6b9926cf8ee9}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Products.Summary}" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding ScanMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyHint}" TextWrapping="Wrap" Classes="hint" Margin="0,0,0,6"/>
            <ListBox ItemsSource="{Binding Products.Results}" SelectedItem="{Binding Products.SelectedProduct}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock>
                                <Run Text="{Binding Key, Mode=OneWay}" FontFamily="Menlo,Consolas,monospace" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Önizleme ve adet -->
        <DockPanel Grid.Row="1" Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Text T_eb3fc3c299e5}" Classes="section" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                           IsVisible="{Binding Problem, Converter={StaticResource NotEmpty}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_fb2a010eeea2}" Classes="label" Margin="0,0,10,0" />
                    <controls:NumberBox x:Name="CopiesBox" Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="9999" Step="1" Decimals="0" />
                </Grid>
            </StackPanel>
            <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6">
                <Image Source="{Binding PreviewPng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{loc:Text T_d2e7dbfbf899}" MinWidth="120" Classes="accent" Command="{Binding PrintCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Text T_45b2d1c03591}" />
        </DockPanel>
    </Grid>
</views:DialogWindow>
