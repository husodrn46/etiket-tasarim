<views:DialogWindow xmlns:loc="using:AkelEtiket.App.Mac.Localization" x:CompileBindings="False" x:Class="AkelEtiket.App.Mac.Views.PrintWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:AkelEtiket.App.Mac.Views"
                    xmlns:controls="using:AkelEtiket.App.Mac.Controls"
                    Title="{loc:Text T_9b13de85b6c1}" Width="1040" Height="800" MinWidth="900" MinHeight="640" CanResize="True">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: ayarlar -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Classes="card" Padding="10,8" Margin="0,0,0,10"
                        IsVisible="{Binding Banner, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Info}" />
                </Border>

                <TextBlock Text="{loc:Text T_a400e1011910}" Classes="section" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding ProfileList}" SelectedItem="{Binding SelectedProfile}"
                          ToolTip.Tip="{loc:Text T_95289cc73cb9}" />
                <TextBlock Text="{Binding ProfileNotes}" Classes="hint" TextWrapping="Wrap" Margin="0,6,0,0"
                           IsVisible="{Binding ProfileNotes, Converter={StaticResource NotEmpty}}" />
                <TextBlock Text="{Binding ProfileWarning}" Classes="hint" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding ProfileWarning, Converter={StaticResource NotEmpty}}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{loc:Text T_ce913e6493a3}" Command="{Binding SaveProfileAsCommand}" Margin="0,0,6,6" Padding="10,3"
                            ToolTip.Tip="{loc:Text T_dee341c42720}" />
                    <Button Content="{loc:Text T_bf6531d30a81}" Command="{Binding UpdateProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}"
                            ToolTip.Tip="{loc:Text T_f4f55e7c2d55}" />
                    <Button Content="{loc:Text T_09e5a284f6c9}" Command="{Binding RenameProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                    <Button Content="{loc:Text T_f698e9b40f9f}" Command="{Binding DeleteProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                </WrapPanel>

                <TextBlock Text="{loc:Text T_45d121a1fad5}" Classes="section" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" Margin="6,0,0,0" Command="{Binding RefreshPrintersCommand}" ToolTip.Tip="{loc:Text T_ac3f47d51ca7}">
                        <PathIcon Data="{StaticResource Glyph.Refresh}" Width="14" Height="14" />
                    </Button>
                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberBinding="{Binding Name}" />
                </DockPanel>
                <TextBlock Text="{Binding PrinterStatusText}" Classes="hint" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PrinterHint}" Classes="hint" Foreground="{DynamicResource Brush.Info}" Margin="0,4,0,0"
                           IsVisible="{Binding PrinterHint, Converter={StaticResource NotEmpty}}" />

                <TextBlock Text="{loc:Text T_b10697e84402}" Classes="section" />
                <ComboBox ItemsSource="{Binding MethodChoices}" DisplayMemberBinding="{Binding Value}" SelectedValueBinding="{Binding Key}" SelectedValue="{Binding Method}" />
                <TextBlock Text="{Binding MethodHint}" Classes="hint" Margin="0,6,0,0" />

                <StackPanel IsVisible="{Binding IsTspl}">
                    <TextBlock Text="{loc:Text T_7276e05c1a52}" Classes="section" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_e08b347cee37}" Classes="label" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Density}" />
                        <TextBlock Grid.Column="2" Text="{Binding Density}" Classes="unit" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_0cceaa1115be}" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding Speed}" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_d2cbe5a8b1a5}" Classes="unit" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_56a6b2f472d4}" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TearChoices}" DisplayMemberBinding="{Binding Value}" SelectedValueBinding="{Binding Key}" SelectedValue="{Binding TearMode}" />
                    </Grid>
                    <CheckBox Content="{loc:Text T_fdebd90d9e2b}" IsChecked="{Binding Rotate180}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_23e7f11beaaa}" Classes="label" />
                        <controls:NumberBox Grid.Column="1" Value="{Binding OffsetXMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip.Tip="{loc:Text T_3cdb19af8f1c}" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Classes="unit" Margin="4,0,8,0" />
                        <controls:NumberBox Grid.Column="3" Value="{Binding OffsetYMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip.Tip="{loc:Text T_50d13a143905}" />
                        <TextBlock Grid.Column="4" Text="{loc:Text T_8fa1dddd5360}" Classes="unit" />
                    </Grid>
                    <CheckBox Content="{loc:Text T_aac3482558f7}" IsChecked="{Binding SingleJob}" Margin="0,10,0,0"
                              ToolTip.Tip="{loc:Text T_ce5e974c3cfc}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="24,2,0,0"
                               Text="{loc:Text T_b9d10f005a4c}" />
                </StackPanel>

                <TextBlock Text="{loc:Text T_bb8a3be974f8}" Classes="section" />
                <TextBlock FontSize="13" Margin="0,0,0,8">
                    <Run Text="{Binding Label.WidthMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" × " /><Run Text="{Binding Label.HeightMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text="{loc:Text T_c1752600f293}" />
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_e6794f6a7ca4}" Classes="label" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding MediaChoices}" DisplayMemberBinding="{Binding Value}" SelectedValueBinding="{Binding Key}" SelectedValue="{Binding Label.Media}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_c1440e99371b}" Classes="label" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Label.GapMm}" Minimum="0" Maximum="30" Step="0.5" Decimals="2" />
                    <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Classes="unit" />
                </Grid>

                <TextBlock Text="{loc:Text T_918d4a61b17e}" Classes="section" />
                <CheckBox Content="{loc:Text T_49a24f1ef83e}" IsChecked="{Binding UseData}" IsEnabled="{Binding CanUseData}" />
                <Grid Margin="0,8,0,8" IsVisible="{Binding !UseData}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_c64198056bee}" Classes="label" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="99999" Step="1" Decimals="0" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_4f74750a1759}" Classes="label" ToolTip.Tip="{}{SIRA} alanının ilk değeri" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding StartNumber}" Minimum="0" Maximum="99999999" Step="1" Decimals="0" />
                    <TextBlock Grid.Column="2" Text="{}{SIRA} için" Classes="unit" />
                </Grid>
                <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8" />
                <CheckBox Content="{loc:Text T_5020939e9234}" IsChecked="{Binding VerifyBarcodes}" />
                <CheckBox Content="{loc:Text T_279b0d2aa9ea}" IsChecked="{Binding AllowWhenOffline}"
                          ToolTip.Tip="{loc:Text T_7837f93a7394}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Sağ: kontrol, ilerleme, rapor -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{loc:Text T_bc74add79f8b}" Command="{Binding RunPreflightCommand}" Padding="10,4" />
                <TextBlock Text="{loc:Text T_d6307dfccf27}" Classes="section" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" Classes="card" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreflightIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="12"
                                           Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,14,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Classes="hint" />
                    <TextBlock Text="{loc:Text T_a36200bb9264}" Classes="section" Margin="0" />
                </DockPanel>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="3" Classes="card" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Text T_a0cc6769f7f2}"
                                   Classes="hint" IsVisible="{Binding ReportLines.Count, Converter={StaticResource NotPositive}}" />
                        <ItemsControl ItemsSource="{Binding ReportLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,7">
                                        <PathIcon Data="{Binding State, Converter={StaticResource StateToIcon}}" Width="14" Height="14" DockPanel.Dock="Left" Margin="0,1,8,0" Foreground="{Binding State, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Button Grid.Row="4" Command="{Binding ResumeCommand}" Classes="accent" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,5"
                    IsVisible="{Binding CanResume}"
                    ToolTip.Tip="{loc:Text T_6a61f20c6ec1}">
                <TextBlock Text="{Binding ResumeText}" />
            </Button>
        </Grid>

        <!-- Alt düğmeler -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button Content="{loc:Text T_bc2daf2e9754}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        IsVisible="{Binding IsBusy}" />
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="90" IsCancel="True" Margin="0,0,8,0" Click="OnClose" />
                <Button Classes="accent" MinWidth="120" Command="{Binding PrintCommand}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource Glyph.Print}" />
                        <TextBlock Text="{loc:Text T_9b13de85b6c1}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Button Content="{loc:Text T_3d6610acca3c}" Command="{Binding TestPrintCommand}" Margin="0,0,8,6"
                        ToolTip.Tip="{loc:Text T_07fecf18ff4c}" />
                <Button Content="{loc:Text T_c8888c6b5128}" Command="{Binding OpenCalibrationCommand}" Margin="0,0,8,6"
                        ToolTip.Tip="{loc:Text T_03f8bc974056}" />
                <Button Content="{loc:Text T_af6f3859af7c}" Command="{Binding CalibrateCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="{loc:Text T_ae92bb348094}" Command="{Binding FeedCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="{loc:Text T_398c68219f11}" Command="{Binding ShowTsplCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" ToolTip.Tip="{loc:Text T_12375d126577}" />
                <Button Content="{loc:Text T_d9b70ef648f1}" Command="{Binding OpenCountersCommand}" Margin="0,0,8,6" ToolTip.Tip="{}{SAYAC} alanlarının sıradaki değerleri" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</views:DialogWindow>
