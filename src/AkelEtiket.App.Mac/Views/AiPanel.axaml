<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:AkelEtiket.App.Mac.Localization"
             x:Class="AkelEtiket.App.Mac.Views.AiPanel"
             x:CompileBindings="False"
             x:Name="Root">
    <!-- Yapay Zekâ paneli: ajanın önerileri, uygulama içi asistan ve bağlantı etkinliği. -->
    <UserControl.Styles>
        <!-- İleti balonu türe göre biçimlenir (kullanıcı, adım, bilgi, hata). -->
        <Style Selector="Border.bubble">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="Background" Value="{DynamicResource Brush.SelectionSoft}" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
        <Style Selector="Border.bubble.step">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.bubble.info">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.bubble.step > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="Border.bubble.info > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="Border.bubble.error > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
        </Style>
    </UserControl.Styles>
    <Grid Background="{DynamicResource Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve bağlantı durumu -->
        <StackPanel Margin="16,14,12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{loc:Text T_d0ed81c3a86e}">
                    <PathIcon Data="{StaticResource Glyph.Settings}" />
                </Button>
                <TextBlock Text="{loc:Text T_e65f37b28667}" Classes="title" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding ConnectionStatus}" Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,12">

                <!-- Ajanın "uygulamada aç" önerileri -->
                <ItemsControl ItemsSource="{Binding OpenRequests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Padding="12,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{loc:Text T_7b31a9fc4816}" Margin="0,0,6,0"
                                                Command="{Binding #Root.DataContext.DismissOpenRequestCommand}" CommandParameter="{Binding}" />
                                        <Button Content="{loc:Text T_dcc084f9a2e1}" MinWidth="64" Classes="accent"
                                                Command="{Binding #Root.DataContext.OpenRequestedCommand}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{loc:Text T_8a331fdde703}" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{loc:Text T_dd90bca6dd07}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Onay bekleyen öneriler -->
                <TextBlock Text="{loc:Text T_feb8c3feae5a}" Classes="section"
                           IsVisible="{Binding PendingCount, Converter={StaticResource IsPositive}}" />
                <ItemsControl ItemsSource="{Binding Proposals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="hint" TextTrimming="CharacterEllipsis">
                                        <Run Text="{loc:Text T_8e793367275a}" />
                                        <Run Text="{Binding Target, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Text T_c9809cb12580}" Classes="hint" />
                                            <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,3,0,0">
                                                <Image Source="{Binding BeforePng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform" MaxHeight="150"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Text T_765eb2f15309}" Classes="hint" />
                                            <Border Background="White" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Margin="0,3,0,0">
                                                <Image Source="{Binding AfterPng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform" MaxHeight="150"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Changes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,4,0,0"
                                                  IsVisible="{Binding HasConflicts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="{loc:Text T_fd78c713b1a0}" MinWidth="86" Margin="0,0,8,0"
                                                Command="{Binding #Root.DataContext.RejectCommand}" CommandParameter="{Binding}" />
                                        <Button Content="{loc:Text T_050c0536feb2}" MinWidth="96" Classes="accent"
                                                Command="{Binding #Root.DataContext.AcceptCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:Text T_c4ec768d3dc0}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Uygulama içi asistan -->
                <TextBlock Text="{loc:Text T_00076d2ac90b}" Classes="section" />
                <TextBlock Text="{Binding AssistantStatus}" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="bubble"
                                    Classes.user="{Binding Kind, Converter={StaticResource EqualsConverter}, ConverterParameter=User}"
                                    Classes.step="{Binding Kind, Converter={StaticResource EqualsConverter}, ConverterParameter=Step}"
                                    Classes.info="{Binding Kind, Converter={StaticResource EqualsConverter}, ConverterParameter=Info}"
                                    Classes.error="{Binding Kind, Converter={StaticResource EqualsConverter}, ConverterParameter=Error}">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bağlantı etkinliği -->
                <TextBlock Text="{loc:Text T_54c66e1eb6d3}" Classes="section"
                           IsVisible="{Binding Activity.Count, Converter={StaticResource IsPositive}}" />
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Menlo,Consolas,monospace" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- İstek kutusu -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding ClearMessagesCommand}" ToolTip.Tip="{loc:Text T_8957194bb7c1}">
                        <PathIcon Data="{StaticResource Glyph.Delete}" Width="12" Height="12" />
                    </Button>
                    <CheckBox IsChecked="{Binding OnlySelection}" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{loc:Text T_e75d281d8407}" />
                            <Run Text="{Binding SelectionCount, Mode=OneWay, StringFormat='({0})'}" />
                        </TextBlock>
                    </CheckBox>
                </DockPanel>
                <TextBox x:Name="PromptBox" Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="58" MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ToolTip.Tip="{loc:Text T_369ce2e0ede9}">
                    <TextBox.KeyBindings>
                        <!-- Gönder: macOS'ta ⌘+Enter, diğer sistemlerde Ctrl+Enter (ikisi de çalışır). -->
                        <KeyBinding Gesture="Meta+Enter" Command="{Binding SendCommand}" />
                        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:Text T_5769a8f8aecd}" MinWidth="80" Margin="0,0,8,0" Command="{Binding StopCommand}"
                                IsVisible="{Binding IsRunning}" />
                        <Button Content="{loc:Text T_f269b8b9af62}" MinWidth="90" Classes="accent" Command="{Binding SendCommand}" />
                    </StackPanel>
                    <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                               Text="{loc:Text T_c613bcb4d758}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
