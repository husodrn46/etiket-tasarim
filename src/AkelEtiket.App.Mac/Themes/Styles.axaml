<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Ortak stiller. Standart denetimler (metin kutusu, liste, onay kutusu…) Fluent temasından gelir; buradakiler
    uygulamanın kendi çubuk, panel ve yazı ölçüleridir. Ölçüler Windows uygulamasındaki karşılıklarıyla aynıdır.
  -->

  <Style Selector=":is(Window)">
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Yazı -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="5,0,0,0" />
  </Style>

  <!-- Simge -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="PathIcon.chevron">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
  </Style>
  <Style Selector="PathIcon.rail">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
  </Style>

  <!-- Ayırıcılar -->
  <Style Selector="Rectangle.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="7,0" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Border}" />
  </Style>

  <!-- Araç çubuğu düğmeleri -->
  <Style Selector="Button.toolbar, Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.icon.narrow">
    <Setter Property="Width" Value="22" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
  </Style>

  <!-- Vurgulu düğme (tek vurgu rengi) -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>

  <!-- İletişim kutusu düğmeleri -->
  <Style Selector="Button.dialog">
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Panel düzeni: alan satırı, kart, bölüm başlığı -->
  <Style Selector="Grid.row">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Standart denetimlerin panel içi ölçüleri -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="MaxHeight" Value="160" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Button.card">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SelectionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.card.shape">
    <Setter Property="Width" Value="84" />
    <Setter Property="Height" Value="74" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.icon.align">
    <Setter Property="Width" Value="34" />
  </Style>

  <!-- Açılıp kapanan düğmeler ve bölümlü seçenekler -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SelectionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel3}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource Brush.SelectionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection}" />
  </Style>

  <!-- Bölüm (Expander): ince başlık, varsayılan açık -->
  <Style Selector="Expander">
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ToggleButton DockPanel.Dock="Top" Classes="section-header"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <DockPanel>
              <PathIcon x:Name="Chevron" DockPanel.Dock="Right" Classes="chevron" Data="{StaticResource Glyph.ChevronDown}" />
              <ContentPresenter Content="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </ToggleButton>
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Margin="0,6,0,8"
                            IsVisible="{TemplateBinding IsExpanded}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander:not(:expanded) /template/ PathIcon#Chevron">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>
  <Style Selector="ToggleButton.section-header">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0,10,2,6" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ToggleButton.section-header /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- Sol gezinme şeridi -->
  <Style Selector="RadioButton.rail">
    <Setter Property="Width" Value="76" />
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="Back" Margin="6,1" CornerRadius="6" Background="{TemplateBinding Background}" />
          <Border x:Name="Marker" Width="3" Margin="0,12" CornerRadius="1.5" HorizontalAlignment="Left"
                  Background="{DynamicResource Brush.Accent}" IsVisible="False" />
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.rail:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="RadioButton.rail:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="RadioButton.rail:checked /template/ Border#Marker">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Belge sekmeleri -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="10,2,3,2" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
</Styles>
