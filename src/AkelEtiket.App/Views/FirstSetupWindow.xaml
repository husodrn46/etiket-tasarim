<views:ThemedWindow x:Class="AkelEtiket.App.Views.FirstSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AkelEtiket.App.Views" xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
 Title="İlk kurulum" Width="820" Height="650" MinWidth="700" MinHeight="560" ResizeMode="CanResizeWithGrip">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="İlk etiketinize hazırlanalım" Style="{StaticResource Text.Title}" FontSize="24"/>
   <TextBlock Text="Firma bilgilerinizi ve etiket ölçünüzü bir kez ayarlayın. Hepsini daha sonra değiştirebilirsiniz."
    Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Steps}" SelectedIndex="{Binding StepIndex}" VerticalAlignment="Top" Padding="4" AutomationProperties.Name="Kurulum adımı"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <StackPanel Visibility="{Binding IsCompanyStep, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding Profile}">
      <TextBlock Text="Firma adı"/><TextBox AutomationProperties.AutomationId="SetupCompanyName" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
      <TextBlock Text="Adres"/><TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="66" TextWrapping="Wrap" Margin="0,4,0,14"/>
      <TextBlock Text="Web sitesi"/><TextBox Text="{Binding CompanyWebsite, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
      <WrapPanel><Button Content="Logo seç…" Command="{Binding ChooseLogoCommand}" Margin="0,0,8,0"/>
       <Button Content="Logoyu kaldır" Command="{Binding ClearLogoCommand}"/></WrapPanel>
      <TextBlock Text="{Binding LogoStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsPrinterStep, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Yazıcı (isteğe bağlı)"/>
      <DockPanel Margin="0,4,0,6"><Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshPrintersCommand}" Margin="8,0,0,0"/>
       <ComboBox ItemsSource="{Binding Printers}" IsEditable="True" Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
      <TextBlock Text="{Binding PrinterMessage}" TextWrapping="Wrap" Style="{StaticResource Text.Hint}" Margin="0,0,0,18"/>
      <TextBlock Text="Hazır etiket ölçüsü"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,6,0,14"/>
      <TextBlock Text="Etiket genişliği × yüksekliği (mm)"/>
      <WrapPanel Margin="0,6,0,14"><controls:NumberBox Value="{Binding Profile.DefaultWidthMm}" Width="110" Minimum="5" Maximum="1000" Decimals="2"/>
       <TextBlock Text=" × " VerticalAlignment="Center"/><controls:NumberBox Value="{Binding Profile.DefaultHeightMm}" Width="110" Minimum="5" Maximum="1000" Decimals="2"/></WrapPanel>
      <TextBlock Text="Yazıcının en fazla baskı genişliği (mm)"/><controls:NumberBox Value="{Binding Profile.MaxPrintWidthMm}" Width="110" HorizontalAlignment="Left" Minimum="20" Maximum="300" Decimals="1" Margin="0,6,0,14"/>
      <TextBlock Text="Çözünürlük"/><ComboBox ItemsSource="{Binding Profile.Resolutions}" SelectedItem="{Binding Profile.Resolution}" Margin="0,6,0,14"/>
      <TextBlock Text="{Binding ValidationProblem}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}">
      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="16" Margin="0,0,0,16"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="16"/></Border>
      <CheckBox Content="Firma bilgilerimle örnek şablonlar ekle" IsChecked="{Binding AddTemplates}" Margin="0,0,0,12"/>
      <CheckBox Content="Kaydettikten sonra baskı önizlemesini aç" IsChecked="{Binding OpenPreview}" Margin="0,0,0,16"/>
      <TextBlock Text="Kurulum sırasında baskı gönderilmez. Mevcut şablonlarınız korunur; GS1 numarası üretilmez."
       Style="{StaticResource Text.Hint}" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0">
   <Button DockPanel.Dock="Left" Content="Daha sonra" IsCancel="True" AutomationProperties.AutomationId="DeferFirstSetup"/>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
    <Button Content="Geri" Command="{Binding PreviousCommand}" MinWidth="90" Margin="0,0,8,0"/>
    <Button Content="Devam" Command="{Binding NextCommand}" MinWidth="100" Style="{StaticResource Button.Accent}">
     <Button.Visibility><Binding Path="IsNotFinishStep" Converter="{StaticResource BoolToVisibility}"/></Button.Visibility>
    </Button>
    <Button Content="Kaydet ve başla" MinWidth="140" Style="{StaticResource Button.Accent}" Click="OnSave" AutomationProperties.AutomationId="CompleteFirstSetup"
     Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</views:ThemedWindow>
