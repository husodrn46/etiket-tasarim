<views:ThemedWindow x:Class="AkelEtiket.App.Views.HelpWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="Yardım" Width="720" Height="680" MinWidth="560" MinHeight="420" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="22,16,22,14">
        <TextBlock DockPanel.Dock="Top" Text="Yardım ve kısayollar" Style="{StaticResource Text.Title}" FontSize="18" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Belgeler klasörünü aç" Margin="0,0,8,0" Click="OnOpenDocs" />
                <Button Content="Kapat" MinWidth="96" IsCancel="True" IsDefault="True" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Ayrıntılı belgeler: BENİOKU, kurulum, XP-470B kurulum ve test, yapay zekâ bağlantı rehberi." />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="KISAYOLLAR" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="İPUÇLARI" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Tips}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
