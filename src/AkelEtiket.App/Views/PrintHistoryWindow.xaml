<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.PrintHistoryWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="{loc:Text T_b3298ba4c936}" Width="1180" Height="740" MinWidth="880" MinHeight="520" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="20,14,20,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{loc:Text T_b3298ba4c936}" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:Text T_aff848ed8bd6}" />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <!-- Süzgeçler -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="{loc:Text T_6ff8021ebc21}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker Width="130" SelectedDate="{Binding FromDate}" ToolTip="{loc:Text T_fda98d21f6d0}" VerticalAlignment="Center" />
            <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0" />
            <DatePicker Width="130" SelectedDate="{Binding ToDate}" ToolTip="{loc:Text T_38dd504fe577}" VerticalAlignment="Center" />
            <Button Content="{loc:Text T_1279dae674df}" Margin="8,0,0,0" Padding="10,4" Click="OnToday" />
            <Button Content="{loc:Text T_0bcb5ff74923}" Margin="6,0,0,0" Padding="10,4" Click="OnLastWeek" />
            <TextBlock Text="{loc:Text T_c641dfba8dd1}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="18,0,6,0" />
            <ComboBox Width="220" IsEditable="True" ItemsSource="{Binding TemplateNames}"
                      Text="{Binding TemplateFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T_4e41dbb08860}" />
            <CheckBox Content="{loc:Text T_1e439d3c0b6d}" IsChecked="{Binding OnlyIncomplete}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <Button Content="{loc:Text T_e20480a50c24}" Command="{Binding ClearFiltersCommand}" Margin="14,0,0,0" Padding="10,4" />
            <Button Content="{loc:Text T_63cd725787a8}" Command="{Binding ReloadCommand}" Margin="6,0,0,0" Padding="10,4" />
        </WrapPanel>

        <!-- Alt düğmeler -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text T_ba6188fd6a2c}" Command="{Binding ResumeCommand}" Margin="0,0,8,0" Padding="12,4"
                        ToolTip="{loc:Text T_8349832e4d31}" />
                <Button Content="{loc:Text T_d257bbfe5fc0}" Command="{Binding ReprintCommand}" Margin="0,0,8,0" Padding="12,4"
                        ToolTip="{loc:Text T_a118cfc13fa7}" />
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="96" Style="{StaticResource Button.Accent}" IsCancel="True" Click="OnClose" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{loc:Text T_a3943a07f2e9}" />
                <Run Text="{Binding Folder, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Text T_c9a878720fa5}" Binding="{Binding TimeText}" Width="140" />
                    <DataGridTextColumn Header="{loc:Text T_74a0c4ce3e49}" Binding="{Binding Title}" Width="110" />
                    <DataGridTextColumn Header="{loc:Text T_c641dfba8dd1}" Binding="{Binding DocumentName}" Width="*" />
                    <DataGridTextColumn Header="{loc:Text T_41d23437d010}" Binding="{Binding LabelsSent}" Width="80" />
                    <DataGridTextColumn Header="{loc:Text T_3f48be73fb7d}" Binding="{Binding TotalLabels}" Width="70" />
                    <DataGridTextColumn Header="{loc:Text T_038dab327842}" Binding="{Binding PrinterName}" Width="100" />
                    <DataGridTextColumn Header="{loc:Text T_8bd057388e28}" Binding="{Binding StatusText}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Border.Card}" Padding="10">
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                         Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="12" VerticalContentAlignment="Top" />
            </Border>
        </Grid>
    </DockPanel>
</views:ThemedWindow>
