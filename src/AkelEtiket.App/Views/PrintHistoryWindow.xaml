<views:ThemedWindow x:Class="AkelEtiket.App.Views.PrintHistoryWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="Baskı geçmişi" Width="1180" Height="740" MinWidth="880" MinHeight="520" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="20,14,20,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Baskı geçmişi" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Her baskı işi bu bilgisayarda kaydedilir: şablon, veri dosyası ve seçili satırlar, adet, yazıcı ayarları, rapor aşamaları, hatalar ve kuyruğa gönderilen etiketler. Fiziksel baskı bu kayıtla doğrulanamaz; etiketleri yazıcıdan kontrol edin." />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <!-- Süzgeçler -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="Tarih" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker Width="130" SelectedDate="{Binding FromDate}" ToolTip="Bu tarihten (dahil)" VerticalAlignment="Center" />
            <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0" />
            <DatePicker Width="130" SelectedDate="{Binding ToDate}" ToolTip="Bu tarihe kadar (dahil)" VerticalAlignment="Center" />
            <Button Content="Bugün" Margin="8,0,0,0" Padding="10,4" Click="OnToday" />
            <Button Content="Son 7 gün" Margin="6,0,0,0" Padding="10,4" Click="OnLastWeek" />
            <TextBlock Text="Şablon" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="18,0,6,0" />
            <ComboBox Width="220" IsEditable="True" ItemsSource="{Binding TemplateNames}"
                      Text="{Binding TemplateFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Şablon adı ya da dosya adı (bir kısmı da yazılabilir)" />
            <CheckBox Content="Yalnızca yarım kalanlar" IsChecked="{Binding OnlyIncomplete}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <Button Content="Süzgeçleri temizle" Command="{Binding ClearFiltersCommand}" Margin="14,0,0,0" Padding="10,4" />
            <Button Content="Yenile" Command="{Binding ReloadCommand}" Margin="6,0,0,0" Padding="10,4" />
        </WrapPanel>

        <!-- Alt düğmeler -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kaldığı yerden devam…" Command="{Binding ResumeCommand}" Margin="0,0,8,0" Padding="12,4"
                        ToolTip="Yalnızca bu işte yazıcı kuyruğuna gönderilmemiş etiketleri seçip baskı penceresini açar" />
                <Button Content="Tekrar bas…" Command="{Binding ReprintCommand}" Margin="0,0,8,0" Padding="12,4"
                        ToolTip="Şablonu ve veriyi açıp aynı satır seçimi ve adetlerle baskı penceresini açar (baskı için yine onay gerekir)" />
                <Button Content="Kapat" MinWidth="96" Style="{StaticResource Button.Accent}" IsCancel="True" Click="OnClose" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" · Kayıt klasörü:" />
                <Run Text="{Binding Folder, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zaman" Binding="{Binding TimeText}" Width="140" />
                    <DataGridTextColumn Header="İş" Binding="{Binding Title}" Width="110" />
                    <DataGridTextColumn Header="Şablon" Binding="{Binding DocumentName}" Width="*" />
                    <DataGridTextColumn Header="Gönderilen" Binding="{Binding LabelsSent}" Width="80" />
                    <DataGridTextColumn Header="İstenen" Binding="{Binding TotalLabels}" Width="70" />
                    <DataGridTextColumn Header="Yazıcı" Binding="{Binding PrinterName}" Width="100" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Border.Card}" Padding="10">
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                         Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="12" VerticalContentAlignment="Top" />
            </Border>
        </Grid>
    </DockPanel>
</views:ThemedWindow>
