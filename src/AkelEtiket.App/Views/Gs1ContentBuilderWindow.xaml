<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.Gs1ContentBuilderWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="{loc:Text T_b9a73526483a}" Width="860" Height="720" MinWidth="700" MinHeight="520" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="22,16,22,14">
        <!-- BAŞLIK -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:Text T_ca6500f8231e}" />
            <TextBlock Text="{Binding LoadNote}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding LoadNote, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <!-- DÜĞMELER -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text T_39a8d28c1c6b}" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{loc:Text T_08a24723d591}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnApply"
                        IsEnabled="{Binding CanAccept}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       Text="{loc:Text T_bab1af3efa7e}" />
        </DockPanel>

        <!-- SONUÇ VE DENETİM -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{loc:Text T_06e63e63f6a1}" Style="{StaticResource Text.Section}" />
            <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13.5" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Messages}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,1,8,0"
                                       Text="{Binding Key, Converter={StaticResource StateToGlyph}}"
                                       Foreground="{Binding Key, Converter={StaticResource SeverityToBrush}}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- KISAYOLLAR -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Command="{Binding AddRowCommand}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Add}" FontSize="13" />
                        <TextBlock Text="{loc:Text T_c45e14c36e61}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddSsccCommand}" Content="{loc:Text T_af2bb2217169}"
                        ToolTip="{loc:Text T_a039831c42de}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text T_1428d629a9e2}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Gtins}" SelectedItem="{Binding SelectedGtin}" DisplayMemberPath="Display"
                          IsEnabled="{Binding HasGtins}" FontFamily="Consolas" />
                <Button Grid.Column="2" Content="{loc:Text T_b0dc157fef6d}" Command="{Binding UseGtinAs01Command}" Margin="6,0,0,0"
                        ToolTip="{loc:Text T_e8872de8dde1}" />
                <Button Grid.Column="3" Content="{loc:Text T_6d4bc8079cee}" Command="{Binding UseGtinAs02Command}" Margin="6,0,0,0"
                        ToolTip="{loc:Text T_f026903626e5}" />
            </Grid>
            <TextBlock Text="{Binding GtinNote}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- AI SATIRLARI -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Border.Card}" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.AiChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Ai}" IsTextSearchEnabled="True" TextSearch.TextPath="Ai" ToolTip="{loc:Text T_989c70e40d2d}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Display, Mode=OneWay}" FontFamily="Consolas" />
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" Margin="8,0,0,0" IsEditable="True" ItemsSource="{Binding Suggestions}"
                                              Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                              ToolTip="{loc:Text T_5977c361f198}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_6820b3bd2486}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.MoveRowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_9b1be60f99f3}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.MoveRowDownCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronDown}" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_6665d044932d}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Delete}" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{Binding ProblemKey, Converter={StaticResource SeverityToBrush}}"
                                           Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
