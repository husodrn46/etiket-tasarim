<UserControl xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AkelEtiket.App.Views"
             xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
             xmlns:geo="clr-namespace:AkelEtiket.Core.Geometry;assembly=AkelEtiket.Core"
             xmlns:model="clr-namespace:AkelEtiket.Core.Model;assembly=AkelEtiket.Core">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>

        <!-- ───────── METİN ───────── -->
        <DataTemplate x:Key="TextTemplate">
            <StackPanel>
                <Expander Header="{loc:Text T_e5417667ec53}">
                    <StackPanel>
                        <TextBox Tag="ContentEditor" Style="{StaticResource TextBox.Multiline}"
                                 Text="{Binding Model.Text, UpdateSourceTrigger=PropertyChanged}" FontSize="13.5" />
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,5,0,8" Text="{}{SütunAdı} ile veri bağlayın; {TARIH}, {SAAT}, {SIRA} yerleşik alanlardır." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="True" ToolTip="{loc:Text T_5d0b017cd876}"
                                      ItemsSource="{Binding DataContext.FontFamilies, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Text="{Binding Model.FontFamily, UpdateSourceTrigger=PropertyChanged, Delay=400}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <controls:NumberBox Grid.Column="2" Value="{Binding Model.FontSize}" Minimum="2" Maximum="500" Step="1" Decimals="1" ToolTip="{loc:Text T_6282f5326f11}" />
                            <TextBlock Grid.Column="3" Text="{loc:Text T_e75b11da693d}" Style="{StaticResource Unit}" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <ToggleButton Style="{StaticResource Toggle.Icon}" IsChecked="{Binding Model.Bold}" ToolTip="{loc:Text T_cd7dcde22e36}" Margin="0,0,4,0">
                                <TextBlock Text="{loc:Text T_86be9a55762d}" FontWeight="Bold" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Toggle.Icon}" IsChecked="{Binding Model.Italic}" ToolTip="{loc:Text T_cde8fa365cbb}" Margin="0,0,4,0">
                                <TextBlock Text="{loc:Text T_e632b7095b0b}" FontStyle="Italic" FontSize="14" FontFamily="Times New Roman" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Toggle.Icon}" IsChecked="{Binding Model.Underline}" ToolTip="{loc:Text T_e9f00d4e7490}" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Text T_559aead08264}" TextDecorations="Underline" FontSize="14" />
                            </ToggleButton>
                            <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=h{0}}" ToolTip="{loc:Text T_87da055900cb}"
                                         IsChecked="{Binding Model.HorizontalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Left}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.TextLeft}" FontSize="14" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=h{0}}" ToolTip="{loc:Text T_c332ec882f67}"
                                         IsChecked="{Binding Model.HorizontalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Center}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.TextCenter}" FontSize="14" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=h{0}}" ToolTip="{loc:Text T_ec32ddfdf26a}"
                                         IsChecked="{Binding Model.HorizontalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Right}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.TextRight}" FontSize="14" />
                            </RadioButton>
                        </WrapPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_9bd3c084d7c8}" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=v{0}}" Content="{loc:Text T_9d0ccf19ae87}"
                                             IsChecked="{Binding Model.VerticalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Top}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=v{0}}" Content="{loc:Text T_e8d77d452a3b}"
                                             IsChecked="{Binding Model.VerticalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Middle}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="{Binding Id, StringFormat=v{0}}" Content="{loc:Text T_c91da2e0203b}"
                                             IsChecked="{Binding Model.VerticalAlignment, Converter={StaticResource EqualsConverter}, ConverterParameter=Bottom}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="{loc:Text T_ead412c040ad}" IsChecked="{Binding Model.WordWrap}" />
                        <CheckBox Content="{loc:Text T_caae189681f5}" IsChecked="{Binding Model.AutoShrink}" />
                        <Grid Style="{StaticResource Row}" Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_296b7ee4327f}" Style="{StaticResource FieldLabel}" />
                            <controls:NumberBox Grid.Column="1" Value="{Binding Model.LineSpacing}" Minimum="0.5" Maximum="3" Step="0.05" Decimals="2" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_8a408daf36a2}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.InkColors}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding Model.TextColor}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_184c6c59a9fe}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.Fills}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding Model.Background}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Hint}">
                            <Run Text="{loc:Text T_1a808a5db984}" />
                            <Run Text="{Binding RenderResult.Text.EffectiveFontSizePt, StringFormat={}{0:0.#} pt, Mode=OneWay}" />
                            <Run Text="•" />
                            <Run Text="{Binding RenderResult.Text.UsedFamily, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- ───────── BARKOD ───────── -->
        <DataTemplate x:Key="BarcodeTemplate">
            <StackPanel>
                <Expander Header="{loc:Text T_8699a582c206}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding DataContext.AllBarcodeTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Type" SelectedValue="{Binding Model.Symbology}" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Margin="6,0,0,0" ToolTip="{loc:Text T_6eaffbd583d1}"
                                    Command="{Binding DataContext.GenerateBarcodeValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Refresh}" FontSize="14" />
                            </Button>
                            <TextBox Tag="ContentEditor" Text="{Binding Model.Content, UpdateSourceTrigger=PropertyChanged, Delay=250}" FontFamily="Consolas" FontSize="13.5" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,8"
                                   Text="{loc:Text T_a2254f68c2fb}" />
                        <!-- GS1 içerik oluşturucu (GS1-128, GS1 DataMatrix, GS1 QR) -->
                        <Button Margin="0,0,0,8" HorizontalAlignment="Left"
                                Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='Gs1_128,Gs1DataMatrix,Gs1QrCode'}"
                                Command="{Binding DataContext.OpenGs1BuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{loc:Text T_090a85bf9bfd}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Edit}" FontSize="14" />
                                <TextBlock Text="{loc:Text T_da5d9dfdf483}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Modül genişliği -->
                        <Border Style="{StaticResource Border.Card}" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding BarcodeModuleText, Converter={StaticResource NullToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_376859792c69}"
                                            Command="{Binding DataContext.BarcodeModuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="−" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_adbe51b7d5f5}"
                                            Command="{Binding DataContext.BarcodeFitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Fit}" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Icon}" ToolTip="{loc:Text T_f088e671c53c}"
                                            Command="{Binding DataContext.BarcodeModuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="+" FontSize="16" />
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Text T_4d7acf540230}" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Text="{Binding BarcodeModuleText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <CheckBox Content="{loc:Text T_f0424607a268}" IsChecked="{Binding Model.ShowText}" />
                        <Grid Style="{StaticResource Row}" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_ae24e6b73192}" Style="{StaticResource FieldLabel}" />
                            <controls:NumberBox Grid.Column="1" Value="{Binding Model.TextSize}" Minimum="0" Maximum="72" Step="0.5" Decimals="1" ToolTip="{loc:Text T_ca16d8c6bcfd}" />
                            <TextBlock Grid.Column="2" Text="{loc:Text T_5559c97206ee}" Style="{StaticResource Unit}" />
                        </Grid>
                        <CheckBox Content="{loc:Text T_09a76b0d3760}" IsChecked="{Binding Model.QuietZone}"
                                  ToolTip="{loc:Text T_d1a6db80dbf7}" />

                        <!-- Code 39 / ITF -->
                        <StackPanel Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='Code39,Itf,Itf14'}" Margin="0,6,0,0">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_5572d72b3ebb}" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="2" Maximum="3" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Value="{Binding Model.WideToNarrowRatio}" />
                                <TextBlock Grid.Column="2" Text="{Binding Model.WideToNarrowRatio, StringFormat={}{0:0.0}}" Style="{StaticResource Unit}" />
                            </Grid>
                        </StackPanel>
                        <CheckBox Content="{loc:Text T_3c61ab0065b1}" IsChecked="{Binding Model.AppendCheckDigit}"
                                  Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='Code39,Itf'}" />
                        <CheckBox Content="{loc:Text T_41b48e380039}" IsChecked="{Binding Model.BearerBars}"
                                  Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='Itf14'}" />

                        <!-- QR -->
                        <Grid Style="{StaticResource Row}" Margin="0,6,0,8"
                              Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='QrCode,Gs1QrCode'}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_87f8f4ea6a8d}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.QrLevels}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding Model.QrErrorCorrection}" />
                        </Grid>
                        <!-- Data Matrix -->
                        <Grid Style="{StaticResource Row}" Margin="0,6,0,8"
                              Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='DataMatrix,Gs1DataMatrix'}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_0c70be7a66c9}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.DataMatrixShapes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding Model.DataMatrixShape}" />
                        </Grid>
                        <!-- PDF417 -->
                        <StackPanel Visibility="{Binding Model.Symbology, Converter={StaticResource InListToVisibility}, ConverterParameter='Pdf417'}" Margin="0,6,0,0">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_87f8f4ea6a8d}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.Pdf417Levels}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding Model.Pdf417ErrorCorrection}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_48611b33a0d8}" Style="{StaticResource FieldLabel}" />
                                <controls:NumberBox Grid.Column="1" Value="{Binding Model.Pdf417Columns}" Minimum="0" Maximum="30" Step="1" Decimals="0" />
                                <TextBlock Grid.Column="2" Text="{loc:Text T_ca16d8c6bcfd}" Style="{StaticResource Unit}" />
                            </Grid>
                        </StackPanel>

                        <Button Margin="0,10,0,0" Command="{Binding DataContext.VerifyBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{loc:Text T_ae4cf0c1e081}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Success}" FontSize="14" />
                                <TextBlock Text="{loc:Text T_bb17b0a77160}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Brush.Panel2}"
                                Visibility="{Binding VerificationMessage, Converter={StaticResource NullToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="15" Margin="0,1,8,0"
                                           Text="{Binding VerificationSuccess, Converter={StaticResource StateToGlyph}}"
                                           Foreground="{Binding VerificationSuccess, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="{Binding VerificationMessage}" TextWrapping="Wrap" FontSize="12" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- ───────── GÖRSEL ───────── -->
        <DataTemplate x:Key="ImageTemplate">
            <StackPanel>
                <Expander Header="{loc:Text T_ea7f441e1e93}">
                    <StackPanel>
                        <TextBlock Text="{Binding ImageSourceText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Button Content="{loc:Text T_3154d3e5560f}" Margin="0,0,4,0"
                                    Command="{Binding DataContext.ReplaceImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="{loc:Text T_fba825c0369c}" Margin="4,0,0,0" ToolTip="{loc:Text T_f3fd59335c51}"
                                    Command="{Binding DataContext.RestoreImageAspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </UniformGrid>
                    </StackPanel>
                </Expander>
                <Expander Header="{loc:Text T_be2977ad7b39}">
                    <StackPanel>
                        <ComboBox ItemsSource="{x:Static views:Choices.ImageMethods}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Model.Method}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,10">
                            <Run Text="{loc:Text T_1264dd08f398}" />
                            <Run Text="{Binding RenderResult.Image.AppliedMethodText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_b3e1a6068621}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Text T_13ed3649db40}" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="254" Value="{Binding Model.Threshold, Delay=120}" SmallChange="1" LargeChange="8" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.Threshold}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_c1fa9a9cd70d}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Model.Brightness, Delay=120}" SmallChange="1" LargeChange="10" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.Brightness}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_f857e3bb4870}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Model.Contrast, Delay=120}" SmallChange="1" LargeChange="10" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.Contrast}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_f2719fea9076}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Text T_dce20ccd9d17}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Model.Sharpen, Delay=120}" SmallChange="1" LargeChange="10" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.Sharpen}" Style="{StaticResource Unit}" />
                        </Grid>
                        <CheckBox Content="{loc:Text T_d5dd6a5c70b8}" IsChecked="{Binding Model.Invert}" />
                    </StackPanel>
                </Expander>
                <Expander Header="{loc:Text T_f3d865545b87}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="{loc:Text T_bbb47728532e}" />
                        <ComboBox IsEditable="True" Text="{Binding Model.SourceField, UpdateSourceTrigger=LostFocus}"
                                  ItemsSource="{Binding DataContext.Data.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{loc:Text T_9fccc1fd61de}" />
                    </StackPanel>
                </Expander>
                <Expander Header="{loc:Text T_044a0ffdd5f9}">
                    <StackPanel>
                        <ComboBox ItemsSource="{x:Static views:Choices.FitModes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Model.FitMode}" Margin="0,0,0,10" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_365a5948f989}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Model.CropLeft, Converter={StaticResource FractionToPercent}, Delay=120}" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.CropLeft, Converter={StaticResource FractionToPercent}, StringFormat={}{0:0}}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_1b4a8d9119f0}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Model.CropRight, Converter={StaticResource FractionToPercent}, Delay=120}" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.CropRight, Converter={StaticResource FractionToPercent}, StringFormat={}{0:0}}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_a5a0bdef956a}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Model.CropTop, Converter={StaticResource FractionToPercent}, Delay=120}" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.CropTop, Converter={StaticResource FractionToPercent}, StringFormat={}{0:0}}" Style="{StaticResource Unit}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Text T_be16847168d9}" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Model.CropBottom, Converter={StaticResource FractionToPercent}, Delay=120}" />
                            <TextBlock Grid.Column="2" Text="{Binding Model.CropBottom, Converter={StaticResource FractionToPercent}, StringFormat={}{0:0}}" Style="{StaticResource Unit}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- ───────── ŞEKİL ───────── -->
        <DataTemplate x:Key="ShapeTemplate">
            <Expander Header="{loc:Text T_d67100ca5521}">
                <StackPanel>
                    <ComboBox ItemsSource="{x:Static views:Choices.ShapeKinds}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Model.Kind}" Margin="0,0,0,10" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_1a116abb390d}" Style="{StaticResource FieldLabel}" />
                        <controls:NumberBox Grid.Column="1" Value="{Binding Model.StrokeWidth}" Minimum="0" Maximum="50" Step="0.125" Decimals="3" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_bbee649c1deb}" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_a024bf947423}" Style="{StaticResource FieldLabel}" />
