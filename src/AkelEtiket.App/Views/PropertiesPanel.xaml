                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_b33226a5d92c}" Style="{StaticResource FieldLabel}" />
                        <controls:NumberBox Grid.Column="1" Value="{Binding Model.CornerRadius}" Minimum="0" Maximum="500" Step="0.5" Decimals="2" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}"
                          Visibility="{Binding Model.Kind, Converter={StaticResource InListToVisibility}, ConverterParameter='Line'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_3639300c0b11}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.LineOrientations}" DisplayMemberPath="Value" SelectedValuePath="Key"
