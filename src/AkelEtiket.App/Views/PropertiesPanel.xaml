                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_234629522e49}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.Fills}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Model.Fill}" />
