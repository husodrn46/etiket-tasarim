                </StackPanel>
            </Expander>
        </DataTemplate>

        <views:ElementTemplateSelector x:Key="ElementTemplateSelector"
                                       TextTemplate="{StaticResource TextTemplate}"
                                       BarcodeTemplate="{StaticResource BarcodeTemplate}"
                                       ImageTemplate="{StaticResource ImageTemplate}"
                                       ShapeTemplate="{StaticResource ShapeTemplate}" />

        <Style x:Key="AlignButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Command" Value="{Binding AlignCommand}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}">
        <Grid>
            <!-- ───────── Seçim yok: etiket ───────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel Margin="18,16,18,18">
                    <TextBlock Text="{loc:Text T_bc91fce11d6f}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_d0b4f0efea0f}" Style="{StaticResource Text.Hint}" Margin="0,4,0,8" />
                    <TextBlock Text="{loc:Text T_c3d94cf25c76}" Style="{StaticResource Text.Section}" />
                    <TextBox Text="{Binding Session.Document.Name, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Text T_29c06e870544}" />
                    <TextBox Style="{StaticResource TextBox.Multiline}" MinHeight="48" Margin="0,8,0,0" ToolTip="{loc:Text T_e4db2a5a5454}"
                             Text="{Binding Session.Document.Description, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{loc:Text T_9befd633efbf}" Style="{StaticResource Text.Section}" />
                    <Border Style="{StaticResource Border.Card}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <Run Text="{Binding Session.Document.Label.WidthMm, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                <Run Text="×" />
                                <Run Text="{Binding Session.Document.Label.HeightMm, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                <Run Text="{loc:Text T_8fa1dddd5360}" FontSize="13" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,10">
                                <Run Text="{loc:Text T_3da7e921e5b6}" />
                                <Run Text="{Binding Session.Document.Label.GapMm, Mode=OneWay, StringFormat={}{0:0.##} mm}" />
                                <Run Text="•" />
                                <Run Text="{Binding Session.Document.Label.Media, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="{loc:Text T_db5270d75483}" Command="{Binding LabelSetupCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{loc:Text T_ba3f1d68f96b}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Hint}" LineHeight="18"
                               Text="{loc:Text T_e0588b63724b}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── Çoklu seçim ───────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="18,16,18,18">
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_cc037ebae073}" Style="{StaticResource Text.Section}" />
                    <WrapPanel>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Left}" ToolTip="{loc:Text T_87da055900cb}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignLeft}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.CenterHorizontal}" ToolTip="{loc:Text T_2df68e2624fa}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignCenterH}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Right}" ToolTip="{loc:Text T_ec32ddfdf26a}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignRight}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Top}" ToolTip="{loc:Text T_c32718554a60}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignTop}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.CenterVertical}" ToolTip="{loc:Text T_4ae0d741608d}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignCenterV}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Bottom}" ToolTip="{loc:Text T_aa325a1495a5}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignBottom}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.DistributeHorizontal}" ToolTip="{loc:Text T_b6a09fa8fb6d}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.DistributeH}" /></Button>
                        <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.DistributeVertical}" ToolTip="{loc:Text T_cf63b554903c}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.DistributeV}" /></Button>
                    </WrapPanel>
                    <TextBlock Text="{loc:Text T_7fe0fcf5954c}" Style="{StaticResource Text.Section}" />
                    <UniformGrid Columns="2">
                        <Button Content="{loc:Text T_f3392de9146a}" Command="{Binding BringToFrontCommand}" Margin="0,0,4,6" />
                        <Button Content="{loc:Text T_451feb1b6459}" Command="{Binding SendToBackCommand}" Margin="4,0,0,6" />
                        <Button Content="{loc:Text T_dfbb76f06e9a}" Command="{Binding ToggleLockCommand}" Margin="0,0,4,6" />
                        <Button Content="{loc:Text T_47ba418cd3f5}" Command="{Binding DuplicateCommand}" Margin="4,0,0,6" />
                    </UniformGrid>
                    <Button Content="{loc:Text T_5444ad83f745}" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── Tek öğe ───────── -->
            <ScrollViewer x:Name="SingleScroll" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedElement, Converter={StaticResource NullToVisibility}}">
                <StackPanel Margin="18,14,18,18" DataContext="{Binding SelectedElement}">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Model.KindName}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{StaticResource Glyph.Lock}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Warning}" ToolTip="{loc:Text T_ed211474d7da}" VerticalAlignment="Center"
                                   Visibility="{Binding Model.Locked, Converter={StaticResource BoolToVisibility}}" />
                        <Border />
                    </DockPanel>
                    <TextBox Text="{Binding Model.Name, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:Text T_d56604ae4417}" Margin="0,4,0,0" />

                    <Expander Header="{loc:Text T_1298e583f63d}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_4b68ab3847fe}" Style="{StaticResource FieldLabel}" />
                                <controls:NumberBox Grid.Column="1" Value="{Binding Model.X}" Step="0.5" Decimals="2" Minimum="-1000" Maximum="2000" ToolTip="{loc:Text T_4ddbf0f624df}" />
                                <TextBlock Grid.Column="3" Text="{loc:Text T_18f5384d58bc}" Style="{StaticResource FieldLabel}" />
                                <controls:NumberBox Grid.Column="4" Value="{Binding Model.Y}" Step="0.5" Decimals="2" Minimum="-1000" Maximum="2000" ToolTip="{loc:Text T_dbd27c491e85}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_333e0a1e2781}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Text T_3e1ccc36249e}" />
                                <controls:NumberBox Grid.Column="1" Value="{Binding Model.Width}" Step="0.5" Decimals="2" Minimum="0.1" Maximum="2000" ToolTip="{loc:Text T_907b8ec7ae0f}" />
                                <TextBlock Grid.Column="3" Text="{loc:Text T_18f5384d58bc}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Text T_4e7c4636b6ee}" />
                                <controls:NumberBox Grid.Column="4" Value="{Binding Model.Height}" Step="0.5" Decimals="2" Minimum="0.1" Maximum="2000" ToolTip="{loc:Text T_ee72683e9be5}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text T_92d262631b8e}" Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <controls:NumberBox Width="64" Value="{Binding Model.Rotation}" Step="1" Decimals="1" Minimum="-360" Maximum="720" ToolTip="{loc:Text T_b5dfaa2e74f9}" />
                                    <TextBlock Text="°" Style="{StaticResource Unit}" Margin="3,0,8,0" />
                                    <Button Style="{StaticResource Button.Icon}" Click="OnRotate90" ToolTip="{loc:Text T_d58c348d315e}">
                                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Rotate}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <CheckBox Content="{loc:Text T_3f0a3653ae48}" IsChecked="{Binding Model.Locked}" Margin="0,0,18,0" />
                                <CheckBox Content="{loc:Text T_d30938608bbb}" IsChecked="{Binding Model.Visible}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Text T_f55981661328}">
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Left}" ToolTip="{loc:Text T_e45403e61cae}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignLeft}" /></Button>
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.CenterHorizontal}" ToolTip="{loc:Text T_ab9dc54564e0}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignCenterH}" /></Button>
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Right}" ToolTip="{loc:Text T_69e46cc0c631}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignRight}" /></Button>
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Top}" ToolTip="{loc:Text T_245f0a878376}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignTop}" /></Button>
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.CenterVertical}" ToolTip="{loc:Text T_57d68a8b4a93}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignCenterV}" /></Button>
                                <Button Style="{StaticResource AlignButton}" CommandParameter="{x:Static geo:AlignMode.Bottom}" ToolTip="{loc:Text T_a35ab11a04f2}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.AlignBottom}" /></Button>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding BringToFrontCommand}" ToolTip="{loc:Text T_38a7461cf7cd}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.BringToFront}" /></Button>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding BringForwardCommand}" ToolTip="{loc:Text T_0e155665a54b}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.BringForward}" /></Button>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding SendBackwardCommand}" ToolTip="{loc:Text T_ac12fe881291}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.SendBackward}" /></Button>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding SendToBackCommand}" ToolTip="{loc:Text T_2b2d7a44c946}"><Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.SendToBack}" /></Button>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding DuplicateCommand}" ToolTip="{loc:Text T_d0576deda66c}"><TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Duplicate}" FontSize="14" /></Button>
                                <Button Style="{StaticResource Button.Icon}" Width="34" Command="{Binding DeleteCommand}" ToolTip="{loc:Text T_213905768b86}"><TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Delete}" FontSize="14" /></Button>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Text T_e46a08b4c986}">
                        <StackPanel>
                            <CheckBox Content="{loc:Text T_95c6b3719d6d}" IsChecked="{Binding ConditionEnabled}" Margin="0,0,0,6"
                                      ToolTip="{loc:Text T_31e16e46f0e9}" />
                            <StackPanel Visibility="{Binding ConditionEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Text T_0059bfc57922}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding ConditionField, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.Data.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ToolTip="{loc:Text T_7add36aec044}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Text T_6bf936ffe8c6}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static views:Choices.ConditionOperators}" DisplayMemberPath="Value"
                                              SelectedValuePath="Key" SelectedValue="{Binding ConditionOperator}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}" Visibility="{Binding ConditionNeedsValue, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Text T_4cfa2b03d54b}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding ConditionValue, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="{loc:Text T_2f7e7a3c1018}" />
                                </Grid>
                                <TextBlock Text="{Binding ConditionStatusText}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding ConditionStatusText, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ElementTemplateSelector}" Focusable="False" />

                    <!-- Sorunlar -->
                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{DynamicResource Brush.Panel2}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,1,8,0"
                                                   Text="{Binding Severity, Converter={StaticResource StateToGlyph}}"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
