<UserControl xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.LeftPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AkelEtiket.Editor.ViewModels;assembly=AkelEtiket.Editor"
             xmlns:doc="clr-namespace:AkelEtiket.Editor.Documents;assembly=AkelEtiket.Editor"
             xmlns:views="clr-namespace:AkelEtiket.App.Views">
    <UserControl.Resources>
        <!-- Barkod türü kartı -->
        <DataTemplate x:Key="BarcodeTypeCard">
            <Button Style="{StaticResource Button.Card}" Command="{Binding DataContext.AddBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Type}" ToolTip="{loc:Text T_4615c1fde964}">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Hint}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Example}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Brush.Info}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Şekil düğmesi -->
        <Style x:Key="ShapeButton" TargetType="Button" BasedOn="{StaticResource Button.Card}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
        <Grid>
            <!-- ───────── METİN ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Text}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{loc:Text T_80422e38652c}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_459749e7125d}" Style="{StaticResource Text.Hint}" Margin="0,4,0,12" />
                    <Button Style="{StaticResource Button.Card}" Command="{Binding AddTextStyleCommand}" CommandParameter="Baslik">
                        <TextBlock Text="{loc:Text T_ca3dbfdf6cb1}" FontSize="20" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource Button.Card}" Command="{Binding AddTextStyleCommand}" CommandParameter="AltBaslik">
                        <TextBlock Text="{loc:Text T_ec61779edece}" FontSize="15" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource Button.Card}" Command="{Binding AddTextStyleCommand}" CommandParameter="Govde">
                        <TextBlock Text="{loc:Text T_06455df7d342}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource Button.Card}" Command="{Binding AddTextStyleCommand}" CommandParameter="Kucuk">
                        <TextBlock Text="{loc:Text T_34658ade9050}" FontSize="11" />
                    </Button>

                    <TextBlock Text="{loc:Text T_b0cfe2154b74}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,8"
                               Text="{loc:Text T_9f8dd932de3b}" />
                    <WrapPanel>
                        <Button Content="{}{TARIH}" Margin="0,0,6,6" Command="{Binding InsertFieldCommand}" CommandParameter="TARIH" ToolTip="{loc:Text T_300e04bff0de}" />
                        <Button Content="{}{SAAT}" Margin="0,0,6,6" Command="{Binding InsertFieldCommand}" CommandParameter="SAAT" ToolTip="{loc:Text T_e9025a1ed686}" />
                        <Button Content="{}{SIRA:0000}" Margin="0,0,6,6" Command="{Binding InsertFieldCommand}" CommandParameter="SIRA:0000" ToolTip="{loc:Text T_b0c8114dcd65}" />
                        <Button Content="{}{TARIH+30}" Margin="0,0,6,6" Command="{Binding InsertFieldCommand}" CommandParameter="TARIH+30" ToolTip="{loc:Text T_5d83ebf4f387}" />
                        <Button Content="{}{SAYAC:000000}" Margin="0,0,6,6" Command="{Binding InsertFieldCommand}" CommandParameter="SAYAC:000000" ToolTip="{loc:Text T_66aab99a1f9c}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="{loc:Text T_3ac40db3ff20}" />
                    <ItemsControl ItemsSource="{Binding Data.Columns}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Command="{Binding DataContext.InsertFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{loc:Text T_8be82d7983e0}">
                                    <TextBlock>
                                        <Run Text="{}{" /><Run Text="{Binding Mode=OneWay}" /><Run Text="}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0"
                               Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                               Text="{loc:Text T_a722139f39be}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── BARKOD ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Barcode}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{loc:Text T_13be6cbab43a}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_e3d915886d27}" Style="{StaticResource Text.Hint}" Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding LinearBarcodeTypes}" ItemTemplate="{StaticResource BarcodeTypeCard}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── QR / 2B ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=QrCode}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{loc:Text T_ed28d3442ea0}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_0907f493150a}" Style="{StaticResource Text.Hint}" Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding MatrixBarcodeTypes}" ItemTemplate="{StaticResource BarcodeTypeCard}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── GÖRSEL ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Image}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{loc:Text T_5694c05b1a70}" Style="{StaticResource Text.Title}" />
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding AddImageCommand}" Margin="0,12,0,10" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Image}" />
                            <TextBlock Text="{loc:Text T_122a47549d70}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1.5" CornerRadius="10" Padding="14,18" Background="{DynamicResource Brush.Panel2}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Glyph.Image}" Style="{StaticResource Text.Glyph}" FontSize="26" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:Text T_e2101624fb1d}" TextAlignment="Center"
                                       Style="{StaticResource Text.Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{loc:Text T_b5bb050ab092}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,8"
                               Text="{loc:Text T_e924b2fe041b}" />
                    <ItemsControl ItemsSource="{Binding Symbols}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ShapeButton}" Width="76" ToolTip="{Binding ToolTip}"
                                        Command="{Binding DataContext.InsertSymbolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}">
                                    <StackPanel>
                                        <Border Width="34" Height="34" Background="White" CornerRadius="4" HorizontalAlignment="Center">
                                            <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="Uniform" Margin="2"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding ShortName}" FontSize="10" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxHeight="28" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Text T_9cf4f251fc80}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Text="{loc:Text T_567bac84e5ff}" />
                    <TextBlock Text="{loc:Text T_be2977ad7b39}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Text="{loc:Text T_307a221c7ed5}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── ŞEKİL ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Shapes}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,10,16">
                    <TextBlock Text="{loc:Text T_36a6fb9dac11}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_a0bc30f18b9d}" Style="{StaticResource Text.Hint}" Margin="0,4,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="Rectangle">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.Rectangle}" />
                                <TextBlock Text="{loc:Text T_d0a7782b0e67}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="RoundRect">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.RoundRect}" />
                                <TextBlock Text="{loc:Text T_ef891fba0870}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="Circle">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.Circle}" />
                                <TextBlock Text="{loc:Text T_436afd8b2eb9}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="Ellipse">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.Ellipse}" />
                                <TextBlock Text="{loc:Text T_220b8926fd40}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="HLine">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.HLine}" />
                                <TextBlock Text="{loc:Text T_3bdc43dad304}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="VLine">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.VLine}" />
                                <TextBlock Text="{loc:Text T_082a2d588e00}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="DLine">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.DLine}" />
                                <TextBlock Text="{loc:Text T_749ef784c3d2}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="FilledRect">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.FilledRect}" />
                                <TextBlock Text="{loc:Text T_cd814c1c035f}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShapeButton}" Command="{Binding AddShapeCommand}" CommandParameter="Frame">
                            <StackPanel>
                                <Path Style="{StaticResource Path.Icon}" Width="26" Height="26" Data="{StaticResource Icon.Frame}" />
                                <TextBlock Text="{loc:Text T_afdffe699908}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── ŞABLONLAR ───────── -->
            <DockPanel Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Templates}" Margin="16,14,16,12">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding Templates.RefreshCommand}" ToolTip="{loc:Text T_63cd725787a8}">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Refresh}" FontSize="14" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding Templates.OpenFolderCommand}" ToolTip="{loc:Text T_2a7c046a4bbf}">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Folder}" FontSize="14" />
                        </Button>
                        <TextBlock Text="{loc:Text T_7856aa3c2171}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Templates.Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="{loc:Text T_eb80a0cb5755}" ToolTip="{loc:Text T_24e4107ec1a2}" Margin="0,10,0,6"/>
                    <ComboBox ItemsSource="{Binding Templates.LocalizedCategories}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Templates.Category}"/>
                    <TextBlock Text="{Binding Templates.ResultSummary}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0"/>
                    <Button Content="{loc:Text T_6f5697f24c96}" Command="{Binding SaveAsTemplateCommand}" Margin="0,10,0,10" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Style="{StaticResource Button.Accent}" Content="{loc:Text T_49af6e145635}" Command="{Binding Templates.UseCommand}" CommandParameter="{Binding Templates.SelectedItem}" Margin="0,0,0,6" />
                    <UniformGrid Columns="4">
                        <Button Content="{loc:Text T_ea33b58c1d8e}" Command="{Binding Templates.EditCommand}" CommandParameter="{Binding Templates.SelectedItem}" Margin="0,0,4,0" Padding="4,6" ToolTip="{loc:Text T_91075b416380}" />
                        <Button Content="{loc:Text T_47ba418cd3f5}" Command="{Binding Templates.DuplicateCommand}" CommandParameter="{Binding Templates.SelectedItem}" Margin="0,0,4,0" Padding="4,6" />
                        <Button Content="{loc:Text T_1d97c9fec35a}" Command="{Binding Templates.RenameCommand}" CommandParameter="{Binding Templates.SelectedItem}" Margin="0,0,4,0" Padding="4,6" ToolTip="{loc:Text T_2de7525d280c}" />
                        <Button Content="{loc:Text T_f698e9b40f9f}" Command="{Binding Templates.DeleteCommand}" CommandParameter="{Binding Templates.SelectedItem}" Padding="4,6" />
                    </UniformGrid>
                    <Button Content="{loc:Text T_373bf4e53b57}" Command="{Binding Templates.RestoreSamplesCommand}" Margin="0,6,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Templates.Items}" SelectedItem="{Binding Templates.SelectedItem}" MouseDoubleClick="OnTemplateDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" Background="White" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="Uniform" Margin="3"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Hint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ───────── VERİ ───────── -->
            <ScrollViewer Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Data}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{loc:Text T_1f6eaed5ee84}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{loc:Text T_c67837bfbc7a}" Style="{StaticResource Text.Hint}" Margin="0,4,0,12" />
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding LoadDataCommand}" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Data}" />
                            <TextBlock Text="{loc:Text T_ed11198cb7ae}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <StackPanel Visibility="{Binding Data.HasData, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Border.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Data.Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Data.ValidationSummary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding Data.IsExcel, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <TextBlock Text="{loc:Text T_6b2c64c33c7d}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Data.SheetNames}" SelectedItem="{Binding Data.SelectedSheet}" />
                        </StackPanel>
                        <Grid Visibility="{Binding Data.IsCsv, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Text T_533f1b8bdf28}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Data.EncodingChoices}" SelectedItem="{Binding Data.SelectedEncoding}" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Text T_d84e4cec0cf5}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Data.DelimiterChoices}" SelectedItem="{Binding Data.SelectedDelimiter}" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Text T_82b8884018aa}" Style="{StaticResource Text.Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding Data.PreviousPreviewCommand}" ToolTip="{loc:Text T_5a59a76009d6}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronLeft}" FontSize="12" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding Data.PreviewText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding Data.NextPreviewCommand}" ToolTip="{loc:Text T_5b693271b7a2}">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronRight}" FontSize="12" />
                            </Button>
                        </Grid>
                        <Button Content="{loc:Text T_47d7b12105b7}" Margin="0,10,0,0" Click="OnOpenDataTable" />

                        <TextBlock Text="{loc:Text T_fe205c7a5f9e}" Style="{StaticResource Text.Section}" />
                        <ComboBox ItemsSource="{Binding Data.Columns}" SelectedItem="{Binding Data.CopiesColumn}" ToolTip="{loc:Text T_04ecfee5c483}" />

                        <TextBlock Text="{loc:Text T_1c39c043b395}" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Data.Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Card}" Margin="0,0,0,4" Padding="10,6"
                                            Command="{Binding DataContext.InsertFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="{loc:Text T_a6d58bc760b7}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{StaticResource Glyph.Add}" Style="{StaticResource Text.Glyph}" FontSize="11" />
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Text T_b5a038364a82}" Style="{StaticResource Text.Section}"
                                   Visibility="{Binding Data.Issues, Converter={StaticResource NullToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Data.Issues}" MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{loc:Text T_7c45b4a6739b}" Command="{Binding ClearDataCommand}" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── KATMANLAR ───────── -->
            <DockPanel Visibility="{Binding ActivePanel, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Layers}" Margin="12,14,12,12">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Text T_20e905dc87dc}" Style="{StaticResource Text.Title}" Margin="4,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{loc:Text T_fe52071efa3f}" Style="{StaticResource Text.Hint}" Margin="4,0,0,10" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,8,0,0">
                    <Button Command="{Binding BringForwardCommand}" ToolTip="{loc:Text T_0e155665a54b}" Margin="0,0,4,0">
                        <Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.BringForward}" />
                    </Button>
                    <Button Command="{Binding SendBackwardCommand}" ToolTip="{loc:Text T_ac12fe881291}" Margin="0,0,4,0">
                        <Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.SendBackward}" />
                    </Button>
                    <Button Command="{Binding DuplicateCommand}" ToolTip="{loc:Text T_47ba418cd3f5}" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Duplicate}" FontSize="14" />
                    </Button>
                    <Button Command="{Binding DeleteCommand}" ToolTip="{loc:Text T_f698e9b40f9f}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Delete}" FontSize="14" />
                    </Button>
                </UniformGrid>
                <ListBox x:Name="LayerList" SelectionMode="Extended" SelectionChanged="OnLayerSelectionChanged" MouseDoubleClick="OnLayerDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type doc:ElementViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding KindKey, Converter={StaticResource KindToIcon}}" Width="16" Height="16" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource IconFont}" FontSize="15" />
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type Geometry}">
                                            <Path Data="{Binding}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform" Width="15" Height="15" />
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{StaticResource Glyph.Warning}" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource Brush.Error}"
                                           Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}"
                                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="26" Height="24"
                                        Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="{loc:Text T_c20882dfd11e}">
                                    <TextBlock x:Name="Eye" Style="{StaticResource Text.Glyph}" FontSize="13" Text="{StaticResource Glyph.Visible}" />
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Width="26" Height="24"
                                        Command="{Binding DataContext.ToggleElementLockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="{loc:Text T_399de06e1d61}">
                                    <TextBlock x:Name="Lock" Style="{StaticResource Text.Glyph}" FontSize="13" Text="{StaticResource Glyph.Unlock}" Opacity="0.45" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Model.Visible}" Value="False">
                                    <Setter TargetName="Eye" Property="Text" Value="{StaticResource Glyph.Hidden}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Model.Locked}" Value="True">
                                    <Setter TargetName="Lock" Property="Text" Value="{StaticResource Glyph.Lock}" />
                                    <Setter TargetName="Lock" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
