<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.BackupsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="{loc:Text T_2bc4396b93f7}" Width="520" Height="480" MinWidth="420" MinHeight="300" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Text.Title}" FontSize="17">
                <Run Text="{loc:Text T_78e5fdae705f}" />
                <Run Text="{Binding DesignName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{loc:Text T_213aa2553584}" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{loc:Text T_1b1ab065b3db}" MinWidth="130" Style="{StaticResource Button.Accent}" Command="{Binding OpenCommand}" />
            </StackPanel>
            <Border />
        </DockPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Display" />
    </DockPanel>
</views:ThemedWindow>
