<views:ThemedWindow x:Class="AkelEtiket.App.Views.ProductsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="Ürün listesi" Width="860" Height="640" MinWidth="620" MinHeight="420" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Ürün listesi" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Ürünlerinizi Excel/CSV'den bir kez aktarın; Hızlı Baskı'da ad, kod ya da barkodla bulunur. Liste bu bilgisayarda saklanır (Belgeler\Etiket Tasarım\Ürünler)." />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Excel/CSV'den aktar…" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Ad, kod veya barkod" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Text.Hint}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Kapat" MinWidth="96" IsCancel="True" IsDefault="True" />
            <Border />
        </DockPanel>
        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedProduct}" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock>
                            <Run Text="{Binding Key, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</views:ThemedWindow>
