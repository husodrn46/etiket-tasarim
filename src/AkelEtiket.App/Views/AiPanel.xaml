<UserControl x:Class="AkelEtiket.App.Views.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:AkelEtiket.Editor.Ai;assembly=AkelEtiket.Editor"
             x:Name="Root">
    <Grid Background="{DynamicResource Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve bağlantı durumu -->
        <StackPanel Margin="16,14,12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="Yapay zekâ ayarları ve bağlantı bilgileri">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Settings}" />
                </Button>
                <TextBlock Text="Yapay Zekâ" Style="{StaticResource Text.Title}" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,12">

                <!-- Ajanın "uygulamada aç" önerileri -->
                <ItemsControl ItemsSource="{Binding OpenRequests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Border.Card}" Padding="12,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Kapat" Margin="0,0,6,0"
                                                Command="{Binding DataContext.DismissOpenRequestCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <Button Content="Aç" MinWidth="64" Style="{StaticResource Button.Accent}"
                                                Command="{Binding DataContext.OpenRequestedCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="&quot;" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="&quot; tasarımını açmanızı öneriyor." />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Onay bekleyen öneriler -->
                <TextBlock Text="ONAY BEKLEYEN ÖNERİLER" Style="{StaticResource Text.Section}"
                           Visibility="{Binding PendingCount, Converter={StaticResource PositiveToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Proposals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ai:ProposalItemViewModel}">
                            <Border Style="{StaticResource Border.Card}" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis">
                                        <Run Text="Hedef:" />
                                        <Run Text="{Binding Target, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Önce" Style="{StaticResource Text.Hint}" />
                                            <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,3,0,0">
                                                <Image Source="{Binding BeforePng, Converter={StaticResource PngToImage}}" Stretch="Uniform" MaxHeight="150"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Sonra" Style="{StaticResource Text.Hint}" />
                                            <Border Background="White" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Margin="0,3,0,0">
                                                <Image Source="{Binding AfterPng, Converter={StaticResource PngToImage}}" Stretch="Uniform" MaxHeight="150"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Changes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,4,0,0"
                                                  Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Reddet" MinWidth="86" Margin="0,0,8,0"
                                                Command="{Binding DataContext.RejectCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <Button Content="Kabul et" MinWidth="96" Style="{StaticResource Button.Accent}"
                                                Command="{Binding DataContext.AcceptCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                ToolTip="Değişiklikler tek adımda uygulanır; Ctrl+Z ile geri alınabilir." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Uygulama içi asistan -->
                <TextBlock Text="ASİSTAN" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{Binding AssistantStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ai:AssistantMessageViewModel}">
                            <Border x:Name="Bubble" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" Background="{DynamicResource Brush.Hover}">
                                <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="User">
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.SelectionSoft}" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="28,0,0,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Step">
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Bubble" Property="Padding" Value="2,0" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="0,0,0,2" />
                                    <Setter TargetName="Body" Property="FontSize" Value="11" />
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                    <Setter TargetName="Body" Property="FontFamily" Value="Consolas" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Info">
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bağlantı etkinliği -->
                <TextBlock Text="BAĞLANTI ETKİNLİĞİ" Style="{StaticResource Text.Section}"
                           Visibility="{Binding Activity.Count, Converter={StaticResource PositiveToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- İstek kutusu -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding ClearMessagesCommand}" ToolTip="Sohbeti temizle">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Delete}" FontSize="12" />
                    </Button>
                    <CheckBox IsChecked="{Binding OnlySelection}" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Yalnızca seçili nesneler" />
                            <Run Text="{Binding SelectionCount, Mode=OneWay, StringFormat='({0})'}" />
                        </TextBlock>
                    </CheckBox>
                </DockPanel>
                <TextBox x:Name="PromptBox" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="58" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                         ToolTip="Örn: Logoyu 5 mm sağa taşı, ürün adını büyüt. (Göndermek için Ctrl+Enter)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Durdur" MinWidth="80" Margin="0,0,8,0" Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Gönder" MinWidth="90" Style="{StaticResource Button.Accent}" Command="{Binding SendCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                               Text="Sonuç önce öneri olarak gelir; siz onaylamadan tasarım değişmez." />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
