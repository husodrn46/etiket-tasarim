<views:ThemedWindow x:Class="AkelEtiket.App.Views.DataTableWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="Veri tablosu" Width="1100" Height="720" MinWidth="760" MinHeight="480" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="18,14,18,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Sütunları eşleştir…" Command="{Binding MapColumnsCommand}" Margin="0,0,14,0"/>
                <TextBlock Text="Adet sütunu" Style="{StaticResource Text.Label}" />
                <ComboBox Width="160" ItemsSource="{Binding Columns}" SelectedItem="{Binding CopiesColumn}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource Text.Hint}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Ara" Style="{StaticResource Text.Label}" />
            <TextBox x:Name="SearchBox" Width="240" Margin="0,0,14,0" VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="Tüm sütunlarda ve sorun metninde arar; Türkçe harf ve büyük/küçük harf farkı gözetilmez (isik → IŞIK). Birden çok sözcük yazılırsa hepsini içeren satırlar gösterilir." />
            <CheckBox Content="Yalnızca hatalı satırlar" IsChecked="{Binding OnlyErrorRows}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox Content="Yalnızca seçili satırlar" IsChecked="{Binding OnlySelectedRows}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="{Binding VisibleSummary}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="{Binding SelectVisibleLabel}" Command="{Binding SelectVisibleRowsCommand}" Margin="0,0,6,0" />
            <Button Content="{Binding DeselectVisibleLabel}" Command="{Binding DeselectVisibleRowsCommand}" Margin="0,0,6,0" />
            <Button Content="Yalnızca hatasızları seç" Command="{Binding SelectValidRowsCommand}" Margin="0,0,16,0" />
            <TextBlock Text="Satır no" Style="{StaticResource Text.Label}" />
            <TextBox x:Name="RangeBox" Width="160" VerticalContentAlignment="Center" KeyDown="OnRangeKeyDown"
                     Text="{Binding RowRangeText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Excel/CSV satır numaraları: 2-20, 35, 40-42 (40- = 40'tan sona kadar). Seç'e basınca seçim yalnızca bu satırlar olur." />
            <Button Content="Seç" Command="{Binding SelectRowRangeCommand}" Margin="6,0,16,0" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}">
                <Run Text="Basılacak etiket:" />
                <Run Text="{Binding SelectedLabelCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            </TextBlock>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding RangeMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding RangeMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RangeMessageIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Satır numaraları Excel/CSV dosyasındaki gerçek satırlardır. Hatalı satırlar basılmaz, diğerleri etkilenmez."
                       Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Kapat" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <!-- ItemsSource kod tarafında verilir (süzgeç değişince önce düzenleme kaydedilir). -->
        <DataGrid x:Name="Grid" FrozenColumnCount="4" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizing="True" />
    </DockPanel>
</views:ThemedWindow>
