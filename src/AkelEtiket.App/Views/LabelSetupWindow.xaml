<views:ThemedWindow x:Class="AkelEtiket.App.Views.LabelSetupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="{Binding Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="24,18,24,18">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="18" />
        <TextBlock Text="Ölçüler milimetredir; tasarım yazıcı çözünürlüğünden bağımsızdır." Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />

        <TextBlock Text="HAZIR ÖLÇÜLER" Style="{StaticResource Text.Section}" />
        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MaxHeight="210" BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Border}" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="ÖZEL ÖLÇÜ" Style="{StaticResource Text.Section}" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Genişlik × yükseklik" Style="{StaticResource Text.Label}" />
            <controls:NumberBox Grid.Column="1" Value="{Binding WidthMm}" Minimum="5" Maximum="1000" Step="1" Decimals="2" />
            <TextBlock Grid.Column="2" Text="×" Margin="8,0" VerticalAlignment="Center" />
            <controls:NumberBox Grid.Column="3" Value="{Binding HeightMm}" Minimum="5" Maximum="1000" Step="1" Decimals="2" />
            <TextBlock Grid.Column="4" Text="mm" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Medya türü" Style="{StaticResource Text.Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MediaTypes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Media}" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Boşluk / işaret" Style="{StaticResource Text.Label}" />
            <controls:NumberBox Grid.Column="1" Value="{Binding GapMm}" Minimum="0" Maximum="30" Step="0.5" Decimals="2" />
            <TextBlock Grid.Column="2" Text="mm (etiketler arası)" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                   Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Vazgeç" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Tamam" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnOk" IsEnabled="{Binding IsValid}" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
