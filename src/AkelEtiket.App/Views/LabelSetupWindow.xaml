<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.LabelSetupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="{Binding Title}" Width="560" Height="820" MinHeight="500" ResizeMode="CanResizeWithGrip" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,18,24,18">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="18" />
        <TextBlock Text="{loc:Text T_9cd477a88196}" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />

        <TextBlock Text="{loc:Text T_49fafa879e69}" Style="{StaticResource Text.Section}" />
        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MaxHeight="210" BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Border}" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{loc:Text T_69602884e571}" Style="{StaticResource Text.Section}" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Text T_088cd77aa2ba}" Style="{StaticResource Text.Label}" />
            <controls:NumberBox Grid.Column="1" Value="{Binding WidthMm}" Minimum="5" Maximum="1000" Step="1" Decimals="2" />
            <TextBlock Grid.Column="2" Text="×" Margin="8,0" VerticalAlignment="Center" />
            <controls:NumberBox Grid.Column="3" Value="{Binding HeightMm}" Minimum="5" Maximum="1000" Step="1" Decimals="2" />
            <TextBlock Grid.Column="4" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Text T_e6794f6a7ca4}" Style="{StaticResource Text.Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MediaTypes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Media}" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Text T_5a5e68db76d7}" Style="{StaticResource Text.Label}" />
            <controls:NumberBox Grid.Column="1" Value="{Binding GapMm}" Minimum="0" Maximum="30" Step="0.5" Decimals="2" />
            <TextBlock Grid.Column="2" Text="{loc:Text T_f849ba79bcbe}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                   Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />

        <TextBlock Text="{loc:Text T_c1c2b4f6e598}" Style="{StaticResource Text.Section}" Margin="0,18,0,8"/>
        <CheckBox Content="{loc:Text T_124e60394f93}" IsChecked="{Binding Formatting.Enabled}" Margin="0,0,0,10"/>
        <StackPanel IsEnabled="{Binding Formatting.Enabled}">
         <TextBlock Text="{loc:Text T_2e3406b35424}"/><ComboBox ItemsSource="{Binding Formatting.Cultures}" SelectedItem="{Binding Formatting.CultureName}" Margin="0,4,0,8"/>
         <TextBlock Text="{loc:Text T_7d7f4bb7a887}"/><ComboBox ItemsSource="{Binding Formatting.Cultures}" SelectedItem="{Binding Formatting.InputCultureName}" Margin="0,4,0,8"/>
         <TextBlock Text="{loc:Text T_48928c33c70f}"/><ComboBox ItemsSource="{Binding Formatting.DateFormats}" SelectedItem="{Binding Formatting.DateFormat}" Margin="0,4,0,8"/>
         <TextBlock Text="{loc:Text T_288a065b0201}"/><ComboBox ItemsSource="{Binding Formatting.NumberFormats}" SelectedItem="{Binding Formatting.NumberFormat}" Margin="0,4,0,8"/>
         <TextBlock Text="{loc:Text T_3774cd647e7e}"/><ComboBox ItemsSource="{Binding Formatting.Currencies}" SelectedItem="{Binding Formatting.CurrencyCode}" Margin="0,4,0,8"/>
        </StackPanel>
        <TextBlock Text="{Binding Formatting.Preview}" TextWrapping="Wrap" Margin="0,8,0,6"/>
        <TextBlock Text="{loc:Text T_a0c3d649e483}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Text T_39a8d28c1c6b}" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{loc:Text T_79c4b04b6ee8}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnOk" IsEnabled="{Binding IsValid}" />
        </StackPanel>
    </StackPanel></ScrollViewer>
</views:ThemedWindow>
