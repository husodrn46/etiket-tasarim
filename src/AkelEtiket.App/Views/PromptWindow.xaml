<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.PromptWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Width="440" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="24,20,24,18">
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,0,0,10" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Text T_79c4b04b6ee8}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnOk" />
            <Button Content="{loc:Text T_39a8d28c1c6b}" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
