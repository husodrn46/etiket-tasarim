<views:ThemedWindow x:Class="AkelEtiket.App.Views.PrintWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="Yazdır" Width="1040" Height="800" MinWidth="900" MinHeight="640" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: ayarlar -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Border.Card}" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Banner, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Info}" />
                </Border>

                <TextBlock Text="PROFİL" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding ProfileList}" SelectedItem="{Binding SelectedProfile}"
                          ToolTip="Profil seçilince yazıcı, yöntem, yoğunluk, hız, yön, ofset, tek parça ve rulo (medya, boşluk) ayarları uygulanır. Etiket ölçüsü değişmez." />
                <TextBlock Text="{Binding ProfileNotes}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ProfileNotes, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding ProfileWarning}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ProfileWarning, Converter={StaticResource NullToVisibility}}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Profil olarak kaydet…" Command="{Binding SaveProfileAsCommand}" Margin="0,0,6,6" Padding="10,3"
                            ToolTip="Penceredeki ayarları yeni bir profil olarak kaydet" />
                    <Button Content="Güncelle" Command="{Binding UpdateProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}"
                            ToolTip="Seçili profili penceredeki ayarlarla güncelle (hazır profil değiştirilemez)" />
                    <Button Content="Yeniden adlandır…" Command="{Binding RenameProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                    <Button Content="Sil" Command="{Binding DeleteProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                </WrapPanel>

                <TextBlock Text="YAZICI" Style="{StaticResource Text.Section}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Margin="6,0,0,0" Command="{Binding RefreshPrintersCommand}" ToolTip="Yazıcı listesini yenile">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Refresh}" FontSize="14" />
                    </Button>
                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name" />
                </DockPanel>
                <TextBlock Text="{Binding PrinterStatusText}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PrinterHint}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Info}" Margin="0,4,0,0"
                           Visibility="{Binding PrinterHint, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="YÖNTEM" Style="{StaticResource Text.Section}" />
                <ComboBox ItemsSource="{Binding MethodChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Method}" />
                <TextBlock Text="{Binding MethodHint}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />

                <StackPanel Visibility="{Binding IsTspl, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="YAZICI AYARLARI (TSPL)" Style="{StaticResource Text.Section}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Baskı yoğunluğu" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Density}" />
                        <TextBlock Grid.Column="2" Text="{Binding Density}" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Baskı hızı" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding Speed}" />
                        <TextBlock Grid.Column="2" Text="inç/sn (kılavuz 2–5; sipariş sistemi 6)" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yırtma konumu" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TearChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding TearMode}" />
                    </Grid>
                    <CheckBox Content="Baskıyı 180° döndür (yazılar ters çıkıyorsa)" IsChecked="{Binding Rotate180}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ofset (sağ / aşağı)" Style="{StaticResource FieldLabel}" />
                        <controls:NumberBox Grid.Column="1" Value="{Binding OffsetXMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip="Yatay kaydırma (mm); + sağa" />
                        <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource Unit}" Margin="4,0,8,0" />
                        <controls:NumberBox Grid.Column="3" Value="{Binding OffsetYMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip="Dikey kaydırma (mm); + aşağı" />
                        <TextBlock Grid.Column="4" Text="mm" Style="{StaticResource Unit}" />
                    </Grid>
                    <CheckBox Content="Tek parça gönder (araya başka iş girmesin)" IsChecked="{Binding SingleJob}" Margin="0,10,0,0"
                              ToolTip="Toplu baskı 25'erli işler yerine tek Windows işi olarak gönderilir" />
                    <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="24,2,0,0"
                               Text="Bütün etiketler tek iş olarak gönderilir; sipariş sisteminin etiketleri araya giremez. &quot;Baskıyı durdur&quot; yalnızca iş kuyruğa yazılmayı bitirene kadar etkilidir; sonrasında durdurmak için işi Windows yazdırma kuyruğundan iptal etmeniz gerekir ve yazıcıya ulaşmış etiketler yine de basılır." />
                </StackPanel>

                <TextBlock Text="ETİKET / MEDYA" Style="{StaticResource Text.Section}" />
                <TextBlock FontSize="13" Margin="0,0,0,8">
                    <Run Text="{Binding Label.WidthMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" × " /><Run Text="{Binding Label.HeightMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" mm" />
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Medya türü" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding MediaChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Label.Media}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Etiket arası boşluk" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Label.GapMm}" Minimum="0" Maximum="30" Step="0.5" Decimals="2" />
                    <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource Unit}" />
                </Grid>

                <TextBlock Text="ADET VE VERİ" Style="{StaticResource Text.Section}" />
                <CheckBox Content="Veri kaynağındaki seçili satırları bas" IsChecked="{Binding UseData}" IsEnabled="{Binding CanUseData}" />
                <Grid Margin="0,8,0,8" Visibility="{Binding UseData, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kopya sayısı" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="99999" Step="1" Decimals="0" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Başlangıç no" Style="{StaticResource FieldLabel}" ToolTip="{}{SIRA} alanının ilk değeri" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding StartNumber}" Minimum="0" Maximum="99999999" Step="1" Decimals="0" />
                    <TextBlock Grid.Column="2" Text="{}{SIRA} için" Style="{StaticResource Unit}" />
                </Grid>
                <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8" />
                <CheckBox Content="Her etiketteki barkodu basmadan önce okuyarak doğrula" IsChecked="{Binding VerifyBarcodes}" />
                <CheckBox Content="Yazıcı çevrimdışı görünse de gönder (gelişmiş)" IsChecked="{Binding AllowWhenOffline}"
                          ToolTip="USB durumu yanlış algılanırsa kullanın. Yazıcı gerçekten kapalıysa iş kuyrukta bekler." />
            </StackPanel>
        </ScrollViewer>

        <!-- Sağ: kontrol, ilerleme, rapor -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Yeniden kontrol et" Command="{Binding RunPreflightCommand}" Padding="10,4" />
                <TextBlock Text="BASKI ÖNCESİ KONTROL" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Border.Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreflightIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="12"
                                           Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,14,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Hint}" />
                    <TextBlock Text="İLERLEME VE RAPOR" Style="{StaticResource Text.Section}" Margin="0" />
                </DockPanel>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="3" Style="{StaticResource Border.Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Henüz baskı yapılmadı. Rapor; veri üretimi, Windows kuyruğuna gönderim, kuyruk durumu ve fiziksel doğrulamayı ayrı ayrı gösterir."
                                   Style="{StaticResource Text.Hint}" Visibility="{Binding ReportLines.Count, Converter={StaticResource PositiveToVisibility}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding ReportLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,1,8,0"
                                                   Text="{Binding State, Converter={StaticResource StateToGlyph}}"
                                                   Foreground="{Binding State, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Button Grid.Row="4" Command="{Binding ResumeCommand}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,5"
                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Yalnızca yazıcı kuyruğuna gönderilmemiş etiketleri basar (onay sorulur)">
                <TextBlock Text="{Binding ResumeText}" />
            </Button>
        </Grid>

        <!-- Alt düğmeler -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button Content="Baskıyı durdur" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Kapat" MinWidth="90" IsCancel="True" Margin="0,0,8,0" Click="OnClose" />
                <Button Style="{StaticResource Button.Accent}" MinWidth="120" Command="{Binding PrintCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Print}" />
                        <TextBlock Text="Yazdır" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Button Content="Test etiketi bas" Command="{Binding TestPrintCommand}" Margin="0,0,8,6"
                        ToolTip="Kenar çerçevesi, cetvel, merkez ve barkodlar içeren ölçü/kayma kontrol etiketi" />
                <Button Content="Kalibrasyon yardımcısı…" Command="{Binding OpenCalibrationCommand}" Margin="0,0,8,6"
                        ToolTip="Sensör kalibrasyonu, cetvelli kalibrasyon etiketi ve ölçüme göre ofset ayarı" />
                <Button Content="Sensör kalibrasyonu" Command="{Binding CalibrateCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="Etiket ilerlet" Command="{Binding FeedCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="TSPL komutları" Command="{Binding ShowTsplCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" ToolTip="Gönderilecek komutların özeti (tanılama)" />
                <Button Content="Sayaçlar…" Command="{Binding OpenCountersCommand}" Margin="0,0,8,6" ToolTip="{}{SAYAC} alanlarının sıradaki değerleri" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</views:ThemedWindow>
