<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.PrintWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="{loc:Text T_9b13de85b6c1}" Width="1040" Height="800" MinWidth="900" MinHeight="640" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: ayarlar -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Border.Card}" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Banner, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Info}" />
                </Border>

                <TextBlock Text="{loc:Text T_a400e1011910}" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding ProfileList}" SelectedItem="{Binding SelectedProfile}"
                          ToolTip="{loc:Text T_95289cc73cb9}" />
                <TextBlock Text="{Binding ProfileNotes}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ProfileNotes, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding ProfileWarning}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ProfileWarning, Converter={StaticResource NullToVisibility}}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="{loc:Text T_ce913e6493a3}" Command="{Binding SaveProfileAsCommand}" Margin="0,0,6,6" Padding="10,3"
                            ToolTip="{loc:Text T_dee341c42720}" />
                    <Button Content="{loc:Text T_bf6531d30a81}" Command="{Binding UpdateProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}"
                            ToolTip="{loc:Text T_f4f55e7c2d55}" />
                    <Button Content="{loc:Text T_09e5a284f6c9}" Command="{Binding RenameProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                    <Button Content="{loc:Text T_f698e9b40f9f}" Command="{Binding DeleteProfileCommand}" Margin="0,0,6,6" Padding="10,3" IsEnabled="{Binding IsUserProfileSelected}" />
                </WrapPanel>

                <TextBlock Text="{loc:Text T_45d121a1fad5}" Style="{StaticResource Text.Section}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Margin="6,0,0,0" Command="{Binding RefreshPrintersCommand}" ToolTip="{loc:Text T_ac3f47d51ca7}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Refresh}" FontSize="14" />
                    </Button>
                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Name" />
                </DockPanel>
                <TextBlock Text="{Binding PrinterStatusText}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PrinterHint}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Info}" Margin="0,4,0,0"
                           Visibility="{Binding PrinterHint, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="{loc:Text T_b10697e84402}" Style="{StaticResource Text.Section}" />
                <ComboBox ItemsSource="{Binding MethodChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Method}" />
                <TextBlock Text="{Binding MethodHint}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />

                <StackPanel Visibility="{Binding IsTspl, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Text T_7276e05c1a52}" Style="{StaticResource Text.Section}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_e08b347cee37}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Density}" />
                        <TextBlock Grid.Column="2" Text="{Binding Density}" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_0cceaa1115be}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding Speed}" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_d2cbe5a8b1a5}" Style="{StaticResource Unit}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_56a6b2f472d4}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TearChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding TearMode}" />
                    </Grid>
                    <CheckBox Content="{loc:Text T_fdebd90d9e2b}" IsChecked="{Binding Rotate180}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text T_23e7f11beaaa}" Style="{StaticResource FieldLabel}" />
                        <controls:NumberBox Grid.Column="1" Value="{Binding OffsetXMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip="{loc:Text T_3cdb19af8f1c}" />
                        <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" Margin="4,0,8,0" />
                        <controls:NumberBox Grid.Column="3" Value="{Binding OffsetYMm}" Minimum="-20" Maximum="20" Step="0.125" Decimals="3" ToolTip="{loc:Text T_50d13a143905}" />
                        <TextBlock Grid.Column="4" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" />
                    </Grid>
                    <CheckBox Content="{loc:Text T_aac3482558f7}" IsChecked="{Binding SingleJob}" Margin="0,10,0,0"
                              ToolTip="{loc:Text T_ce5e974c3cfc}" />
                    <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="24,2,0,0"
                               Text="{loc:Text T_b9d10f005a4c}" />
                </StackPanel>

                <TextBlock Text="{loc:Text T_bb8a3be974f8}" Style="{StaticResource Text.Section}" />
                <TextBlock FontSize="13" Margin="0,0,0,8">
                    <Run Text="{Binding Label.WidthMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" × " /><Run Text="{Binding Label.HeightMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text="{loc:Text T_c1752600f293}" />
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_e6794f6a7ca4}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding MediaChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Label.Media}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_c1440e99371b}" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Label.GapMm}" Minimum="0" Maximum="30" Step="0.5" Decimals="2" />
                    <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" />
                </Grid>

                <TextBlock Text="{loc:Text T_918d4a61b17e}" Style="{StaticResource Text.Section}" />
                <CheckBox Content="{loc:Text T_49a24f1ef83e}" IsChecked="{Binding UseData}" IsEnabled="{Binding CanUseData}" />
                <Grid Margin="0,8,0,8" Visibility="{Binding UseData, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_c64198056bee}" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="99999" Step="1" Decimals="0" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_4f74750a1759}" Style="{StaticResource FieldLabel}" ToolTip="{}{SIRA} alanının ilk değeri" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding StartNumber}" Minimum="0" Maximum="99999999" Step="1" Decimals="0" />
                    <TextBlock Grid.Column="2" Text="{}{SIRA} için" Style="{StaticResource Unit}" />
                </Grid>
                <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8" />
                <CheckBox Content="{loc:Text T_5020939e9234}" IsChecked="{Binding VerifyBarcodes}" />
                <CheckBox Content="{loc:Text T_279b0d2aa9ea}" IsChecked="{Binding AllowWhenOffline}"
                          ToolTip="{loc:Text T_7837f93a7394}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Sağ: kontrol, ilerleme, rapor -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{loc:Text T_bc74add79f8b}" Command="{Binding RunPreflightCommand}" Padding="10,4" />
                <TextBlock Text="{loc:Text T_d6307dfccf27}" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Border.Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreflightIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="12"
                                           Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,14,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Hint}" />
                    <TextBlock Text="{loc:Text T_a36200bb9264}" Style="{StaticResource Text.Section}" Margin="0" />
                </DockPanel>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="3" Style="{StaticResource Border.Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Text T_a0cc6769f7f2}"
                                   Style="{StaticResource Text.Hint}" Visibility="{Binding ReportLines.Count, Converter={StaticResource PositiveToVisibility}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding ReportLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,1,8,0"
                                                   Text="{Binding State, Converter={StaticResource StateToGlyph}}"
                                                   Foreground="{Binding State, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Button Grid.Row="4" Command="{Binding ResumeCommand}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,5"
                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="{loc:Text T_6a61f20c6ec1}">
                <TextBlock Text="{Binding ResumeText}" />
            </Button>
        </Grid>

        <!-- Alt düğmeler -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button Content="{loc:Text T_bc2daf2e9754}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="90" IsCancel="True" Margin="0,0,8,0" Click="OnClose" />
                <Button Style="{StaticResource Button.Accent}" MinWidth="120" Command="{Binding PrintCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Print}" />
                        <TextBlock Text="{loc:Text T_9b13de85b6c1}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Button Content="{loc:Text T_3d6610acca3c}" Command="{Binding TestPrintCommand}" Margin="0,0,8,6"
                        ToolTip="{loc:Text T_07fecf18ff4c}" />
                <Button Content="{loc:Text T_c8888c6b5128}" Command="{Binding OpenCalibrationCommand}" Margin="0,0,8,6"
                        ToolTip="{loc:Text T_03f8bc974056}" />
                <Button Content="{loc:Text T_af6f3859af7c}" Command="{Binding CalibrateCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="{loc:Text T_ae92bb348094}" Command="{Binding FeedCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" />
                <Button Content="{loc:Text T_398c68219f11}" Command="{Binding ShowTsplCommand}" Margin="0,0,8,6" IsEnabled="{Binding IsTspl}" ToolTip="{loc:Text T_12375d126577}" />
                <Button Content="{loc:Text T_d9b70ef648f1}" Command="{Binding OpenCountersCommand}" Margin="0,0,8,6" ToolTip="{}{SAYAC} alanlarının sıradaki değerleri" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</views:ThemedWindow>
