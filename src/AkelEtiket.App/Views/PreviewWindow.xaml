<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.PreviewWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="{loc:Text T_a914e95b0c73}" Width="1180" Height="820" MinWidth="820" MinHeight="560" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Height="48" Margin="14,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding PreviousCommand}" ToolTip="{loc:Text T_e555bbfbafc3}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronLeft}" FontSize="12" />
                    </Button>
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Margin="8,0" MinWidth="60" TextAlignment="Center" />
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding NextCommand}" ToolTip="{loc:Text T_dd4720fa6412}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronRight}" FontSize="12" />
                    </Button>
                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text T_1cae9843d949}" Style="{StaticResource Text.Label}" />
                    <Slider x:Name="ZoomSlider" Width="160" Minimum="0.5" Maximum="8" Value="2" ToolTip="{loc:Text T_c11eb96e73c5}" />
                    <CheckBox x:Name="ActualSize" Content="{loc:Text T_15de1c011090}" Margin="14,0,0,0" Checked="OnActualSize" Unchecked="OnActualSize" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- Etiket görüntüsü -->
        <ScrollViewer x:Name="ImageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Brush.Workspace}">
            <Border Background="White" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#40808080" BorderThickness="1">
                <Image x:Name="LabelImage" Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
        </ScrollViewer>

        <!-- Sağ panel -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16,14,16,12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Text T_b4e49495350f}" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />
                    <TextBlock Text="{loc:Text T_1a6f38874da7}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{loc:Text T_6f1929898d7f}" Style="{StaticResource Text.Hint}" Visibility="{Binding Issues.Count, Converter={StaticResource PositiveToVisibility}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Issues}" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Text T_b41ef904c993}" Style="{StaticResource Text.Section}" Visibility="{Binding Thumbnails.Count, Converter={StaticResource PositiveToVisibility}}" />
                    <TextBlock Text="{Binding ThumbnailStatus}" Style="{StaticResource Text.Hint}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Thumbnails}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnThumbnailSelected"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="88" ToolTip="{Binding Problem}">
                                <Border x:Name="Frame" Width="84" Height="84" Background="White" BorderThickness="2" BorderBrush="Transparent" CornerRadius="4">
                                    <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
                                </Border>
                                <TextBlock Text="{Binding Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Alt düğmeler -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10">
                <Button Content="{loc:Text T_7b31a9fc4816}" MinWidth="90" IsCancel="True" Margin="0,0,8,0" Click="OnClose" />
                <Button Style="{StaticResource Button.Accent}" MinWidth="120" Click="OnPrint">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Print}" />
                        <TextBlock Text="{loc:Text T_d2e7dbfbf899}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</views:ThemedWindow>
