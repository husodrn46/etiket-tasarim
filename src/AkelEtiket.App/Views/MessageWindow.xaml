<views:ThemedWindow x:Class="AkelEtiket.App.Views.MessageWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Width="480" SizeToContent="Height" ResizeMode="NoResize" MaxHeight="640">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" FontFamily="{DynamicResource IconFont}" FontSize="26" Margin="0,2,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                             TextWrapping="Wrap" FontSize="13" MinHeight="0" VerticalContentAlignment="Top" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="Buttons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</views:ThemedWindow>
