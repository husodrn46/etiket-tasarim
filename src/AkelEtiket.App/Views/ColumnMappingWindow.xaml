<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.ColumnMappingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AkelEtiket.App.Views" Title="{loc:Text T_79bc2a1fc4e1}" Width="790" Height="540" MinWidth="660" MinHeight="400">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
   <TextBlock Text="{loc:Text T_57a01dbd710b}" Style="{StaticResource Text.Title}" FontSize="20"/>
   <TextBlock Text="{loc:Text T_94bb131ce248}"
    Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="{loc:Text T_39a8d28c1c6b}" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
   <Button Content="{loc:Text T_1d02026506c1}" IsEnabled="{Binding IsValid}" Click="OnApply" Style="{StaticResource Button.Accent}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Field}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" AutomationProperties.Name="{loc:Text T_eeb792f719d3}"/>
    <TextBlock Grid.Column="2" Text="{Binding Example}" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</views:ThemedWindow>
