<views:ThemedWindow x:Class="AkelEtiket.App.Views.ColumnMappingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AkelEtiket.App.Views" Title="Excel/CSV sütunlarını eşleştir" Width="790" Height="540" MinWidth="660" MinHeight="400">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
   <TextBlock Text="Etiket alanı hangi sütundan gelsin?" Style="{StaticResource Text.Title}" FontSize="20"/>
   <TextBlock Text="Bir veri sütunu seçin ve örnek değerini kontrol edin. Eşleştirme tasarımınıza kaydedilir; Excel/CSV dosyanız değişmez. Ctrl+Z ile geri alabilirsiniz."
    Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="Vazgeç" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
   <Button Content="Eşleştirmeyi uygula" IsEnabled="{Binding IsValid}" Click="OnApply" Style="{StaticResource Button.Accent}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Field}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" AutomationProperties.Name="Veri sütunu"/>
    <TextBlock Grid.Column="2" Text="{Binding Example}" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</views:ThemedWindow>
