<views:ThemedWindow x:Class="AkelEtiket.App.Views.StarterPacksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:AkelEtiket.App.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AkelEtiket.App.Views" Title="{loc:Text T_d3da70f6b70a}" Width="900" Height="680" MinWidth="740" MinHeight="520">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="{loc:Text T_d3da70f6b70a}" Style="{StaticResource Text.Title}" FontSize="22"/><TextBlock Text="{loc:Text T_89ed13ab0b4a}" TextWrapping="Wrap" Style="{StaticResource Text.Hint}" Margin="0,8,0,0"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{loc:Text T_23a090d43c70}" Command="{Binding OpenSamplesCommand}" Margin="0,0,8,0"/><Button Content="{loc:Text T_1f9de09df8f0}" Command="{Binding InstallCommand}" Style="{StaticResource Button.Accent}" Margin="0,0,8,0"/><Button Content="{loc:Text T_7b31a9fc4816}" IsCancel="True"/></StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Packs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPack}"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedPack.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPack.Description}" TextWrapping="Wrap" Margin="0,8,0,12"/><Border Background="White" Padding="10" MaxHeight="260"><Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="Uniform"/></Border><TextBlock Text="{Binding SelectedPack.Instructions}" TextWrapping="Wrap" Margin="0,16,0,12"/><TextBlock Text="{Binding SampleFolder}" TextWrapping="Wrap" Style="{StaticResource Text.Hint}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Info}" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</views:ThemedWindow>
