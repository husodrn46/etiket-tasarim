<views:ThemedWindow x:Class="AkelEtiket.App.Views.CountersWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="Sayaçlar" Width="860" Height="560" MinWidth="680" MinHeight="420" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="20,14,20,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Kalıcı sayaçlar ve seri numaraları" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Yeni sayaç…" Command="{Binding AddCommand}" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="Sıradaki değer…" Command="{Binding SetNextCommand}" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="Artış…" Command="{Binding SetStepCommand}" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="Sıfırla" Command="{Binding ResetCommand}" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="Sil" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="Yenile" Command="{Binding RefreshCommand}" Padding="10,4" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Kapat" MinWidth="96" Style="{StaticResource Button.Accent}" IsCancel="True" Click="OnClose" />
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <Run Text="Sayaç dosyası:" />
                <Run Text="{Binding FilePath, Mode=OneWay}" />
                <Run Text="— yedekleyin; silinirse sayaçlar 1'den başlar." />
            </TextBlock>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Counters}" SelectedItem="{Binding SelectedCounter}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sayaç" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Sıradaki" Binding="{Binding Next}" Width="100" />
                <DataGridTextColumn Header="Artış" Binding="{Binding Step}" Width="60" />
                <DataGridTextColumn Header="Son kullanım" Binding="{Binding LastUsedText}" Width="130" />
                <DataGridTextColumn Header="Son aralık" Binding="{Binding LastRange}" Width="130" />
                <DataGridTextColumn Header="" Binding="{Binding UsageText}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</views:ThemedWindow>
