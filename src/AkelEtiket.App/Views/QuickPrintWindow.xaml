<views:ThemedWindow x:Class="AkelEtiket.App.Views.QuickPrintWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="Hızlı Baskı" Width="1180" Height="720" MinWidth="900" MinHeight="520" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,10">
            <TextBlock Text="Hızlı Baskı" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0"
                       Text="1) Şablonu seçin  2) Ürünü arayın ya da barkod okuyucuyla okutun  3) Adeti yazın  4) Yazdır — yazıcı ayarları ve onay baskı penceresinde." />
        </StackPanel>

        <!-- Şablonlar -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="ŞABLON" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border DockPanel.Dock="Left" Width="54" Height="54" Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,8,0">
                                <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Ürün arama -->
        <DockPanel Grid.Row="1" Grid.Column="2" DataContext="{Binding}">
            <TextBlock DockPanel.Dock="Top" Text="ÜRÜN" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Ürün listesi…" Margin="8,0,0,0" Click="OnManageProducts" />
                <TextBox x:Name="ScanBox" Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                         ToolTip="Ürün kodu/barkod okutun ya da yazıp Enter'a basın">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding Products.Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,6"
                     ToolTip="Listeyi ada, koda veya barkoda göre süz" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Products.Summary}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Products.Results}" SelectedItem="{Binding Products.SelectedProduct}" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock>
                                <Run Text="{Binding Key, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Önizleme ve adet -->
        <DockPanel Grid.Row="1" Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="ÖNİZLEME (BASKI ÇÖZÜNÜRLÜĞÜ)" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Adet" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
                    <controls:NumberBox x:Name="CopiesBox" Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="99999" Step="1" Decimals="0" />
                </Grid>
            </StackPanel>
            <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6">
                <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kapat" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Yazdır…" MinWidth="120" Style="{StaticResource Button.Accent}" Command="{Binding PrintCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Şablon dosyası değişmez: etiket yeni belge olarak açılır ve baskı penceresi gelir." />
        </DockPanel>
    </Grid>
</views:ThemedWindow>
