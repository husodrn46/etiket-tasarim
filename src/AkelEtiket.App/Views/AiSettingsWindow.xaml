<views:ThemedWindow x:Class="AkelEtiket.App.Views.AiSettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="Yapay Zekâ Ayarları" Width="760" Height="820" MinWidth="640" MinHeight="560" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Yapay Zekâ Ayarları" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Bütün yapay zekâ özellikleri isteğe bağlıdır; kapalıyken uygulamanın diğer özellikleri aynen çalışır. Yapay zekânın yazıcıya baskı gönderen bir aracı yoktur." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Vazgeç" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Kaydet" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- DIŞ AJAN BAĞLANTISI -->
                <TextBlock Text="DIŞ AJAN BAĞLANTISI (MCP / YEREL API)" Style="{StaticResource Text.Section}" />
                <CheckBox IsChecked="{Binding Enabled}" FontWeight="SemiBold" Margin="0,0,0,4"
                          Content="Yapay zekâ bağlantısına izin ver (Claude Desktop, Claude Code ve diğer MCP istemcileri)" />
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="24,0,0,10"
                           Text="Açıkken Etiket Tasarım yalnızca bu bilgisayardan (127.0.0.1) ve anahtarla erişilebilen bir yerel API açar. Uygulama kapalıyken istek gelirse penceresiz Worker başlar ve boşta kalınca kapanır. Bağlanan ajan, tasarım içeriğini kendi yapay zekâ servisine gönderebilir." />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding Port}" Minimum="1024" Maximum="65535" Step="1" Decimals="0" />
                    <TextBlock Grid.Column="2" Text="yalnızca 127.0.0.1 (uzak erişim yok)" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bağlantı anahtarı" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding TokenDisplay, Mode=OneWay}" Style="{StaticResource Mono}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <CheckBox Content="Göster" IsChecked="{Binding ShowToken}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Kopyala" Click="OnCopyToken" Margin="0,0,6,0" />
                        <Button Content="Yenile" Command="{Binding RegenerateTokenCommand}" />
                    </StackPanel>
                </Grid>
                <CheckBox IsChecked="{Binding ShareOpenDocument}" Margin="0,0,0,6"
                          Content="Uygulamada açık tasarımı yapay zekâ ile paylaş (ajan açık belgeyi görebilir ve öneri sunabilir)" />
                <CheckBox IsChecked="{Binding EnableHttpMcp}" Margin="0,0,0,6"
                          Content="HTTP üzerinden MCP uç noktası (/mcp) — stdio desteklemeyen yerel istemciler için" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Worker boşta kapanma" Style="{StaticResource FieldLabel}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding WorkerIdleMinutes}" Minimum="1" Maximum="1440" Step="1" Decimals="0" />
                    <TextBlock Grid.Column="2" Text="dakika" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                </Grid>

                <!-- DEĞİŞİKLİK MODU -->
                <TextBlock Text="DEĞİŞİKLİK MODU" Style="{StaticResource Text.Section}" />
                <RadioButton GroupName="Mode" Margin="0,0,0,4" IsChecked="{Binding DirectMode, Converter={StaticResource InverseBool}}"
                             Content="Onaylı (önerilen): yapay zekâ taslakta çalışır; değişiklikler önce/sonra önizlemesiyle bana sunulur, kabul edersem uygulanır." />
                <RadioButton GroupName="Mode" IsChecked="{Binding DirectMode}"
                             Content="Doğrudan: değişiklikler hemen uygulanır (her adım Ctrl+Z ile geri alınabilir; dosyalardan önce yedek alınır)." />
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="24,4,0,0"
                           Text="Her iki modda da: tasarım dosyaları silinmez, var olan dosyanın üzerine izinsiz yazılmaz, kilitli öğeler değiştirilmez." />

                <!-- İZİNLİ KLASÖRLER -->
                <TextBlock Text="İZİNLİ KLASÖRLER" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Yapay zekâ görselleri ve Excel/CSV dosyalarını yalnızca bu klasörlerden okuyabilir (Şablonlar klasörü her zaman izinlidir). Örn. ürün görselleri ve logo klasörü." />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding AllowedFolders}" SelectedItem="{Binding SelectedFolder}" MinHeight="70" MaxHeight="140" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="Klasör ekle…" Click="OnAddFolder" Margin="0,0,0,6" />
                        <Button Content="Kaldır" Command="{Binding RemoveFolderCommand}" />
                    </StackPanel>
                </Grid>

                <!-- UYGULAMA İÇİ ASİSTAN -->
                <TextBlock Text="UYGULAMA İÇİ ASİSTAN" Style="{StaticResource Text.Section}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sağlayıcı" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ProviderKind}" />
                </Grid>
                <StackPanel Visibility="{Binding IsProviderSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8" Visibility="{Binding NeedsBaseUrl, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Uç nokta adresi" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Örn. http://127.0.0.1:11434/v1 (Ollama) veya http://127.0.0.1:1234/v1 (LM Studio)" />
                    </Grid>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="API anahtarı" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="KeyBox" Grid.Column="1" PasswordChanged="OnKeyChanged" />
                        <Button Grid.Column="2" Content="Sil" Margin="8,0,0,0" Command="{Binding ClearKeyCommand}" Click="OnClearKey" />
                    </Grid>
                    <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Text.Hint}" Margin="190,0,0,10" />
                    <Border Style="{StaticResource Border.Card}" Padding="12,9" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Consent}" FontWeight="SemiBold">
                                <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="24,6,0,0"
                                       Text="İzin olmadan asistan hiçbir veri göndermez. Sağlayıcıyı veya adresi değiştirirseniz izin yeniden istenir. Ücretli API kullanımı sağlayıcının kendi koşullarına tabidir; uygulama için zorunlu değildir." />
                        </StackPanel>
                    </Border>
                    <CheckBox IsChecked="{Binding SendPreviewImages}" Content="Önizleme görüntüsünü de gönder (görsel anlayan modeller için)" />
                </StackPanel>

                <!-- BAĞLANTI BİLGİLERİ -->
                <TextBlock Text="BAĞLANTI BİLGİLERİ" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Claude Code (stdio, önerilen): komut satırında çalıştırın." />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Kopyala" Margin="8,0,0,0" Click="OnCopy" Tag="{Binding ClaudeCodeCommand}" />
                    <TextBox Text="{Binding ClaudeCodeCommand, Mode=OneWay}" Style="{StaticResource Mono}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Claude Desktop: %APPDATA%\Claude\claude_desktop_config.json dosyasına ekleyin, sonra Claude Desktop'ı yeniden başlatın." />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Kopyala" Margin="8,0,0,0" Click="OnCopy" Tag="{Binding ClaudeDesktopJson}" />
                    <TextBox Text="{Binding ClaudeDesktopJson, Mode=OneWay}" Style="{StaticResource Mono}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="HTTP MCP (uygulama açıkken; anahtarı içerir, paylaşmayın):" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Kopyala" Margin="8,0,0,0" Click="OnCopy" Tag="{Binding ClaudeCodeHttpCommand}" />
                    <TextBox Text="{Binding ClaudeCodeHttpCommand, Mode=OneWay}" Style="{StaticResource Mono}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap"
                           Text="Ayrıntılı rehber: Belgeler klasöründeki YAPAY-ZEKA-BAGLANTI.md (Claude, Atlas, Hermes ve diğer ajanlar)." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
