<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="{Binding WindowTitle}" Icon="/Assets/AkelEtiket.ico"
                    MinWidth="1080" MinHeight="660" Width="1440" Height="900"
                    WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────────── Üst araç çubuğu ───────────── -->
        <Border Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Height="52" Margin="12,0,10,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/AkelEtiket-256.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Text T_a03425caed30}" FontWeight="SemiBold" FontSize="14.5" Margin="9,0,14,0" VerticalAlignment="Center" />
                    <Separator Style="{StaticResource Separator.Vertical}" />

                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding NewCommand}" ToolTip="{loc:Text T_a2b993762f59}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.New}" />
                            <TextBlock Text="{loc:Text T_e17ccb1e9466}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding OpenCommand}" ToolTip="{loc:Text T_959effc5d14f}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Open}" />
                            <TextBlock Text="{loc:Text T_dcc084f9a2e1}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecentButton" Style="{StaticResource Button.Icon}" Width="22" ToolTip="{loc:Text T_23a9eaaf836e}" Click="OnRecentClick">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronDown}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding SaveDocumentCommand}" ToolTip="{loc:Text T_f6aba48e74f7}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Save}" />
                            <TextBlock Text="{loc:Text T_c1fe2ecdff02}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreFileButton" Style="{StaticResource Button.Icon}" Width="22" ToolTip="{loc:Text T_0442143b72bb}" Click="OnMoreFileClick">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronDown}" FontSize="10" />
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding UndoCommand}" ToolTip="{loc:Text T_c1108f42b43e}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Undo}" />
                    </Button>
                    <Button x:Name="UndoHistoryButton" Style="{StaticResource Button.Icon}" Width="22" ToolTip="{loc:Text T_b2c34226a602}" Click="OnUndoHistoryClick">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ChevronDown}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RedoCommand}" ToolTip="{loc:Text T_6e015c9cbfb7}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Redo}" />
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding CutCommand}" ToolTip="{loc:Text T_7eb2c3c07b7f}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Cut}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding CopyCommand}" ToolTip="{loc:Text T_0ffadf2bf014}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Copy}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding PasteCommand}" ToolTip="{loc:Text T_88adde4c9867}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Paste}" />
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding LabelSetupCommand}" ToolTip="{loc:Text T_68fd79af3412}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Ruler}" />
                            <TextBlock Text="{Binding LabelSizeText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ZoomOutCommand}" ToolTip="{loc:Text T_e8cd1d564f1f}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ZoomOut}" />
                    </Button>
                    <Button Style="{StaticResource Button.Toolbar}" MinWidth="58" Command="{Binding ZoomActualSizeCommand}" ToolTip="{loc:Text T_dc4bcacfc470}">
                        <TextBlock Text="{Binding ZoomText}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ZoomInCommand}" ToolTip="{loc:Text T_4df38779294a}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.ZoomIn}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ZoomFitCommand}" ToolTip="{loc:Text T_19d982d28c61}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Fit}" />
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnToggleGrid" ToolTip="{loc:Text T_8e99c29e8731}">
                        <Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.Grid}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Click="OnToggleSnap" ToolTip="{loc:Text T_9c5816ece93f}">
                        <Path Style="{StaticResource Path.Icon}" Data="{StaticResource Icon.Magnet}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleThemeCommand}" ToolTip="{loc:Text T_8127782e90e5}">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Sun}" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenSettingsCommand}" AutomationProperties.AutomationId="OpenGeneralSettings" AutomationProperties.Name="{loc:Text T_80ad54ad05fa}" ToolTip="{loc:Text T_80ad54ad05fa}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Settings}" />
                    </Button>
                    <Button x:Name="HelpButton" Style="{StaticResource Button.Icon}" Click="OnHelpClick" ToolTip="{loc:Text T_3f5d764c85b3}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Info}" />
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding ToggleAiPanelCommand}"
                            ToolTip="{loc:Text T_b3e7b95fcf9e}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Ai}" />
                                <TextBlock Text="{loc:Text T_e65f37b28667}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-10,0" MinWidth="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource Brush.Warning}" Padding="4,0"
                                    Visibility="{Binding Ai.PendingCount, Converter={StaticResource PositiveToVisibility}}"
                                    ToolTip="{loc:Text T_d3c7db600d0f}">
                                <TextBlock Text="{Binding Ai.PendingCount}" FontSize="10" FontWeight="Bold" Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Separator Style="{StaticResource Separator.Vertical}" />
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding OpenQuickPrintCommand}"
                            ToolTip="{loc:Text T_6d6f82479820}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Label}" />
                            <TextBlock Text="{loc:Text T_930a0da1ee3b}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Toolbar}" Command="{Binding PreviewCommand}" ToolTip="{loc:Text T_9de0257ea86f}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Preview}" />
                            <TextBlock Text="{loc:Text T_0fa5590881e5}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Accent}" Command="{Binding PrintCommand}" Margin="6,0,0,0" Padding="14,6" ToolTip="{loc:Text T_1659e1146a16}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Glyph.Print}" />
                            <TextBlock Text="{loc:Text T_9b13de85b6c1}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- ───────────── Ana alan ───────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Sol gezinme şeridi -->
            <Border Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_06455df7d342}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Text}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.Text}" />
                            <TextBlock Text="{loc:Text T_80422e38652c}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_f79ad7be1269}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Barcode}">
                        <StackPanel>
                            <Path Style="{StaticResource Path.Icon}" Width="19" Height="19" Data="{StaticResource Icon.Barcode}" />
                            <TextBlock Text="{loc:Text T_13be6cbab43a}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_5e47f9009fba}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=QrCode}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.QrCode}" />
                            <TextBlock Text="{loc:Text T_a449fc303f99}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_1ac4e2987465}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Image}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.Image}" />
                            <TextBlock Text="{loc:Text T_5694c05b1a70}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_09a6289e5566}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Shapes}">
                        <StackPanel>
                            <Path Style="{StaticResource Path.Icon}" Width="19" Height="19" Data="{StaticResource Icon.Shapes}" />
                            <TextBlock Text="{loc:Text T_0c70be7a66c9}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Rectangle Height="1" Margin="14,8" Fill="{DynamicResource Brush.Border}" />
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_7856aa3c2171}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Templates}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.Templates}" />
                            <TextBlock Text="{loc:Text T_7856aa3c2171}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_fe8152c12728}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Data}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.Data}" />
                            <TextBlock Text="{loc:Text T_6135a42bf53e}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Radio.Rail}" GroupName="Rail" Click="OnRailClick" ToolTip="{loc:Text T_20e905dc87dc}"
                                 IsChecked="{Binding ActivePanel, Converter={StaticResource EqualsConverter}, ConverterParameter=Layers}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="19" Text="{StaticResource Glyph.Layers}" />
                            <TextBlock Text="{loc:Text T_20e905dc87dc}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Sol panel -->
            <views:LeftPanel x:Name="LeftPanelHost" Grid.Column="1" Width="300"
                             Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisibility}}" />

            <!-- Tuval -->
            <Grid Grid.Column="2" Background="{DynamicResource Brush.Workspace}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="RulerCorner" Width="22" Height="22" Background="{DynamicResource Brush.Ruler}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                    <TextBlock Text="{loc:Text T_8fa1dddd5360}" FontSize="8.5" Foreground="{DynamicResource Brush.RulerText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <controls:RulerControl x:Name="TopRuler" Grid.Column="1" Height="22" Orientation="Horizontal" Surface="{Binding ElementName=Surface}" />
                <controls:RulerControl x:Name="LeftRuler" Grid.Row="1" Width="22" Orientation="Vertical" Surface="{Binding ElementName=Surface}" />
                <ScrollViewer x:Name="CanvasScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Focusable="False" ScrollChanged="OnCanvasScrollChanged">
                    <controls:DesignSurface x:Name="Surface" ViewModel="{Binding}" Zoom="{Binding Zoom}" />
                </ScrollViewer>
                <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,14"
                        Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="10,5" Opacity="0.92" IsHitTestVisible="False">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{loc:Text T_fb345473a47a}" />
                </Border>
            </Grid>

            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource Brush.Border}" />

            <!-- Özellikler / Yapay Zekâ -->
            <views:PropertiesPanel x:Name="Properties" Grid.Column="4"
                                   Visibility="{Binding IsAiPanelOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <views:AiPanel x:Name="AiPanelHost" Grid.Column="4" DataContext="{Binding Ai}"
                           Visibility="{Binding DataContext.IsAiPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ───────────── Durum çubuğu ───────────── -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Height="27" Margin="14,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding LabelSizeText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,22,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CursorText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,22,0" VerticalAlignment="Center" MinWidth="130" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,0,22,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</views:ThemedWindow>
