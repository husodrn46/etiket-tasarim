<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.CalibrationWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    xmlns:controls="clr-namespace:AkelEtiket.App.Controls"
                    Title="{loc:Text T_ddbd4ae5b72e}" Width="760" Height="800" MinWidth="640" MinHeight="560" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{loc:Text T_ddbd4ae5b72e}" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="{Binding PrinterText, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" · " />
                <Run Text="{Binding LabelText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{loc:Text T_5b2207e11590}"
                       Visibility="{Binding IsTspl, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Text T_7b31a9fc4816}" MinWidth="96" IsCancel="True" Click="OnClose" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Info}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <!-- 1. Sensör -->
                <TextBlock Text="{loc:Text T_4a36c90d53b0}" Style="{StaticResource Step}" />
                <TextBlock Text="{Binding SensorText}" TextWrapping="Wrap" FontSize="12.5" />
                <Button Content="{loc:Text T_7f296ad00591}" Command="{Binding DetectSensorCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                        IsEnabled="{Binding CanDetectSensor}" ToolTip="{loc:Text T_c499a29709ad}" />

                <!-- 2. Kalibrasyon etiketi -->
                <TextBlock Text="{loc:Text T_2ab1921b90e7}" Style="{StaticResource Step}" />
                <TextBlock TextWrapping="Wrap" FontSize="12.5"
                           Text="{loc:Text T_b02f503935f9}" />
                <Button Content="{loc:Text T_ebe90565b1f1}" Command="{Binding PrintLabelCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />

                <!-- 3. Yön -->
                <TextBlock Text="{loc:Text T_9113527ea795}" Style="{StaticResource Step}" />
                <TextBlock TextWrapping="Wrap" FontSize="12.5"
                           Text="{loc:Text T_96a91ee0f726}" />
                <TextBlock Text="{Binding DirectionText}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />
                <Button Content="{loc:Text T_5d8db23d1ade}" Command="{Binding FlipDirectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />

                <!-- 4. Ölçüm -->
                <TextBlock Text="{loc:Text T_6b5c49a00271}" Style="{StaticResource Step}" />
                <TextBlock TextWrapping="Wrap" FontSize="12.5"
                           Text="{loc:Text T_821596a74dfb}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Text T_c8b3461f3891}" Style="{StaticResource Text.Label}" />
                    <controls:NumberBox Grid.Column="1" Value="{Binding MeasuredLeftMm}" Minimum="0" Maximum="50" Step="0.25" Decimals="2" />
                    <TextBlock Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" />
                    <TextBlock Grid.Row="2" Text="{loc:Text T_9dce5fdba924}" Style="{StaticResource Text.Label}" />
                    <controls:NumberBox Grid.Row="2" Grid.Column="1" Value="{Binding MeasuredTopMm}" Minimum="0" Maximum="50" Step="0.25" Decimals="2" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Text T_8fa1dddd5360}" Style="{StaticResource Unit}" />
                </Grid>
                <Border Style="{StaticResource Border.Card}" Padding="12,9" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock FontSize="12.5">
                            <Run Text="{loc:Text T_c23ae4a11d0d}" />
                            <Run Text="{Binding CurrentOffsetXMm, Mode=OneWay, StringFormat={}{0:0.###}}" FontWeight="SemiBold" />
                            <Run Text="/" />
                            <Run Text="{Binding CurrentOffsetYMm, Mode=OneWay, StringFormat={}{0:0.###}}" FontWeight="SemiBold" />
                            <Run Text="{loc:Text T_8fa1dddd5360}" />
                        </TextBlock>
                        <TextBlock FontSize="12.5" Margin="0,4,0,0">
                            <Run Text="{loc:Text T_be80215102ed}" />
                            <Run Text="{Binding NewOffsetXMm, Mode=OneWay, StringFormat={}{0:0.###}}" FontWeight="SemiBold" />
                            <Run Text="/" />
                            <Run Text="{Binding NewOffsetYMm, Mode=OneWay, StringFormat={}{0:0.###}}" FontWeight="SemiBold" />
                            <Run Text="{loc:Text T_8fa1dddd5360}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ShiftText}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding TargetProfileText}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Button Content="{loc:Text T_c238092f9f80}" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Accent}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,5" />
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{loc:Text T_9e0d6f34b2bf}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
