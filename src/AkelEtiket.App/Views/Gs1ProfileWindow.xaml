<views:ThemedWindow xmlns:loc="clr-namespace:AkelEtiket.App.Localization" x:Class="AkelEtiket.App.Views.Gs1ProfileWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="{loc:Text T_687be9833cf7}" Width="900" Height="780" MinWidth="760" MinHeight="560" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
    </Window.Resources>
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{loc:Text T_687be9833cf7}" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:Text T_a10b562d52d4}" />
            <TextBlock Text="{Binding LoadProblem}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding LoadProblem, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text T_39a8d28c1c6b}" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{loc:Text T_c1fe2ecdff02}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnSave" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <Run Text="{loc:Text T_8f215bd4f2e0}" />
                <Run Text="{Binding DataFolder, Mode=OneWay}" />
                <Run Text="{loc:Text T_8090db94d735}" />
            </TextBlock>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <!-- FİRMA -->
                <TextBlock Text="{loc:Text T_9364546f15cc}" Style="{StaticResource Text.Section}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_bb32eee2c44c}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_2f71973dd568}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Gln, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </Grid>
                <TextBlock Text="{Binding GlnStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,8"
                           Foreground="{Binding GlnIsValid, Converter={StaticResource SeverityToBrush}}" />

                <!-- FİRMA ÖNEKİ -->
                <TextBlock Text="{loc:Text T_ac6ecd28f32e}" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Border.Card}" Padding="12,9" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                               Text="{loc:Text T_36c6bb3c5cbf}" />
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_71d0fd101658}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding GcpPrefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <CheckBox Grid.Column="2" Content="{loc:Text T_82b9b909d4d5}" IsChecked="{Binding GcpVerified}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding GcpStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2" />
                <TextBlock Text="{Binding VerifiedText}" Style="{StaticResource Text.Hint}" Margin="190,0,0,2" Foreground="{DynamicResource Brush.Success}" />
                <TextBlock Text="{Binding VerificationResetNote}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2"
                           Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding VerificationResetNote, Converter={StaticResource NullToVisibility}}" />
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_7fa1a56b7569}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding GcpVerificationNote, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Text T_c5561812d0d2}" />
                </Grid>

                <!-- SSCC -->
                <TextBlock Text="{loc:Text T_cf90c84f344c}" Style="{StaticResource Text.Section}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_d4fd4d442722}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExtensionDigits}" SelectedItem="{Binding SsccExtensionDigit}" />
                    <TextBlock Grid.Column="2" Text="{loc:Text T_e47448e184c3}" Style="{StaticResource Text.Hint}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text T_41aec37a3467}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding SerialStartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T_a942007517cb}" />
                    <TextBlock Grid.Column="2" Text="–" Margin="8,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding SerialEndText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Text T_e70fd6428696}" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2"
                           Text="{loc:Text T_ce6f6852badc}" />
                <TextBlock Text="{Binding SerialLengthText}" Style="{StaticResource Text.Hint}" Margin="190,0,0,2" />
                <DockPanel Margin="190,4,0,8">
                    <Button DockPanel.Dock="Right" Content="{loc:Text T_63cd725787a8}" Command="{Binding RefreshRegistryCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding RegistrySummary}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <!-- GTIN -->
                <TextBlock Text="{loc:Text T_57db98fa924b}" Style="{StaticResource Text.Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{loc:Text T_f560a85f28c0}" Command="{Binding AddGtinCommand}" Margin="0,0,6,0" />
                    <Button Content="{loc:Text T_00480b8f2d84}" Command="{Binding RemoveGtinCommand}" Margin="0,0,6,0" />
                    <Button Content="{loc:Text T_2507e7d789e0}" Command="{Binding ImportGtinsCommand}" />
                </StackPanel>
                <DataGrid x:Name="GtinGrid" ItemsSource="{Binding Gtins}" SelectedItem="{Binding SelectedGtin}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" Height="190" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Text T_f44fad234051}" Width="150" Binding="{Binding Gtin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <DataGridTemplateColumn Header="{loc:Text T_8bd057388e28}" Width="190" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusText}" Foreground="{Binding IsValid, Converter={StaticResource SeverityToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Text T_292491241e16}" Width="110" Binding="{Binding ProductCode}" />
                        <DataGridTextColumn Header="{loc:Text T_e7ae0d9a164c}" Width="*" Binding="{Binding Description}" />
                        <DataGridTemplateColumn Header="{loc:Text T_ee6538ea6322}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.PackagingChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding PackagingLevel, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- DENETİM -->
                <TextBlock Text="{loc:Text T_de2a4073b7dd}" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="12"
                                       Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SON SSCC KAYITLARI -->
                <TextBlock Text="{loc:Text T_930a77066593}" Style="{StaticResource Text.Section}" />
                <DataGrid ItemsSource="{Binding RecentSscc}" AutoGenerateColumns="False" IsReadOnly="True" Height="170" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Text T_51bda150e1ae}" Width="170" Binding="{Binding Sscc}" FontFamily="Consolas" />
                        <DataGridTextColumn Header="{loc:Text T_8bd057388e28}" Width="150" Binding="{Binding StatusText}" />
                        <DataGridTextColumn Header="{loc:Text T_e5e7870cb7e9}" Width="120" Binding="{Binding AllocatedAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                        <DataGridTextColumn Header="{loc:Text T_e7ae0d9a164c}" Width="*" Binding="{Binding Note}" />
                        <DataGridTextColumn Header="{loc:Text T_06e44c77accf}" Width="100" Binding="{Binding Machine}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- AI -->
                <Expander Header="{loc:Text T_4ce876eaee32}" Margin="0,14,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <CheckBox Content="{loc:Text T_59f636c9e9b5}" IsChecked="{Binding ShowAllAis}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding AiList}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Text T_11fb682be0a0}" Width="64" Binding="{Binding Display}" FontFamily="Consolas" />
                                <DataGridTextColumn Header="{loc:Text T_1d97c9fec35a}" Width="170" Binding="{Binding Title}" />
                                <DataGridTextColumn Header="{loc:Text T_a2381a982dbc}" Width="90" Binding="{Binding Format}" FontFamily="Consolas" />
                                <DataGridTemplateColumn Header="{loc:Text T_e7ae0d9a164c}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:Text T_c26c0c918d0c}" />
                    </StackPanel>
                </Expander>

                <!-- NOTLAR -->
                <TextBlock Text="{loc:Text T_87a67d198e8d}" Style="{StaticResource Text.Section}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="60" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
