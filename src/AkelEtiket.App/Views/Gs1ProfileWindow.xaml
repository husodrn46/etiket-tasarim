<views:ThemedWindow x:Class="AkelEtiket.App.Views.Gs1ProfileWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AkelEtiket.App.Views"
                    Title="GS1 Firma Profili" Width="900" Height="780" MinWidth="760" MinHeight="560" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
    </Window.Resources>
    <DockPanel Margin="22,16,22,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="GS1 Firma Profili" Style="{StaticResource Text.Title}" FontSize="18" />
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="GLN, firma öneki (GCP), SSCC numaralandırması ve kayıtlı ürün numaraları (GTIN). SSCC numaraları yalnızca gerçek baskı sırasında {SSCC} alanı için ayrılır ve kalıcı olarak kaydedilir." />
            <TextBlock Text="{Binding LoadProblem}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding LoadProblem, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Vazgeç" MinWidth="96" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Kaydet" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnSave" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <Run Text="Profil ve SSCC kayıtları:" />
                <Run Text="{Binding DataFolder, Mode=OneWay}" />
                <Run Text="— bu klasörü yedekleyin; kayıtlar silinirse kullanılmış numaralar bilinemez." />
            </TextBlock>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <!-- FİRMA -->
                <TextBlock Text="FİRMA" Style="{StaticResource Text.Section}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Firma adı" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GLN (Küresel Lokasyon No.)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Gln, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </Grid>
                <TextBlock Text="{Binding GlnStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,8"
                           Foreground="{Binding GlnIsValid, Converter={StaticResource SeverityToBrush}}" />

                <!-- FİRMA ÖNEKİ -->
                <TextBlock Text="FİRMA ÖNEKİ (GCP)" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Border.Card}" Padding="12,9" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                               Text="Firma öneki ve uzunluğu GLN'den tahmin edilmez. GS1 Türkiye üyelik belgenizdeki öneki aynen yazın, belgeyle karşılaştırdıktan sonra &quot;Üyelik belgesinden doğrulandı&quot; kutusunu işaretleyin. Doğrulanmadan SSCC üretilmez; yanlış önekle basılan SSCC'ler geri alınamaz." />
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Firma öneki" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding GcpPrefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <CheckBox Grid.Column="2" Content="Üyelik belgesinden doğrulandı" IsChecked="{Binding GcpVerified}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding GcpStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2" />
                <TextBlock Text="{Binding VerifiedText}" Style="{StaticResource Text.Hint}" Margin="190,0,0,2" Foreground="{DynamicResource Brush.Success}" />
                <TextBlock Text="{Binding VerificationResetNote}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2"
                           Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding VerificationResetNote, Converter={StaticResource NullToVisibility}}" />
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Doğrulama notu" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding GcpVerificationNote, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ör. GS1 Türkiye üyelik belgesi, 2026" />
                </Grid>

                <!-- SSCC -->
                <TextBlock Text="SSCC (SERİ NAKLİYE KONTEYNER KODU)" Style="{StaticResource Text.Section}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Uzantı basamağı" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExtensionDigits}" SelectedItem="{Binding SsccExtensionDigit}" />
                    <TextBlock Grid.Column="2" Text="SSCC'nin ilk hanesi (0–9); firma içinde serileri ayırmak için kullanılabilir." Style="{StaticResource Text.Hint}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bu bilgisayarın seri aralığı" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding SerialStartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Boş: 1" />
                    <TextBlock Grid.Column="2" Text="–" Margin="8,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding SerialEndText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Boş: en büyük seri" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="190,0,0,2"
                           Text="Boş bırakılırsa tüm aralık kullanılır. Birden fazla bilgisayar SSCC basacaksa her birine çakışmayan bir aralık verin." />
                <TextBlock Text="{Binding SerialLengthText}" Style="{StaticResource Text.Hint}" Margin="190,0,0,2" />
                <DockPanel Margin="190,4,0,8">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshRegistryCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding RegistrySummary}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <!-- GTIN -->
                <TextBlock Text="KAYITLI GTIN'LER" Style="{StaticResource Text.Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Ekle" Command="{Binding AddGtinCommand}" Margin="0,0,6,0" />
                    <Button Content="Seçileni sil" Command="{Binding RemoveGtinCommand}" Margin="0,0,6,0" />
                    <Button Content="Excel/CSV'den aktar…" Command="{Binding ImportGtinsCommand}" />
                </StackPanel>
                <DataGrid x:Name="GtinGrid" ItemsSource="{Binding Gtins}" SelectedItem="{Binding SelectedGtin}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" Height="190" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GTIN" Width="150" Binding="{Binding Gtin, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <DataGridTemplateColumn Header="Durum" Width="190" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusText}" Foreground="{Binding IsValid, Converter={StaticResource SeverityToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ürün kodu" Width="110" Binding="{Binding ProductCode}" />
                        <DataGridTextColumn Header="Açıklama" Width="*" Binding="{Binding Description}" />
                        <DataGridTemplateColumn Header="Ambalaj" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.PackagingChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding PackagingLevel, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- DENETİM -->
                <TextBlock Text="DENETİM" Style="{StaticResource Text.Section}" />
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="12"
                                       Foreground="{Binding Converter={StaticResource SeverityToBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SON SSCC KAYITLARI -->
                <TextBlock Text="SON SSCC KAYITLARI" Style="{StaticResource Text.Section}" />
                <DataGrid ItemsSource="{Binding RecentSscc}" AutoGenerateColumns="False" IsReadOnly="True" Height="170" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SSCC" Width="170" Binding="{Binding Sscc}" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Durum" Width="150" Binding="{Binding StatusText}" />
                        <DataGridTextColumn Header="Ayrılma" Width="120" Binding="{Binding AllocatedAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                        <DataGridTextColumn Header="Açıklama" Width="*" Binding="{Binding Note}" />
                        <DataGridTextColumn Header="Bilgisayar" Width="100" Binding="{Binding Machine}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- AI -->
                <Expander Header="GS1 UYGULAMA TANIMLAYICILARI (AI)" Margin="0,14,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <CheckBox Content="Tümünü göster (yalnızca sık kullanılanlar yerine)" IsChecked="{Binding ShowAllAis}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding AiList}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="AI" Width="64" Binding="{Binding Display}" FontFamily="Consolas" />
                                <DataGridTextColumn Header="Ad" Width="170" Binding="{Binding Title}" />
                                <DataGridTextColumn Header="Biçim" Width="90" Binding="{Binding Format}" FontFamily="Consolas" />
                                <DataGridTemplateColumn Header="Açıklama" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Barkod içeriğinde AI'lar parantezle yazılır, ör. (00){SSCC} veya (02){GTIN}(37){KoliIciAdet}(10){Parti}. Değişken uzunluklu AI'lardan sonra gereken FNC1 ayırıcısını uygulama ekler." />
                    </StackPanel>
                </Expander>

                <!-- NOTLAR -->
                <TextBlock Text="NOTLAR" Style="{StaticResource Text.Section}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Multiline}" Height="60" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ThemedWindow>
