  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AkelEtiket.PrintEngine.Tests" />
    <InternalsVisibleTo Include="AkelEtiket.Tests" />
  </ItemGroup>
</Project>
